    "settings_ai_recap_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Notiz auf der Übersicht in der ersten Woche jedes Monats: was sich geändert hat und warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short note on Overview in the first week of each month: what changed, and why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota breve en el Resumen durante la primera semana de cada mes: qué cambió y por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte note sur l'aperçu pendant la première semaine de chaque mois : ce qui a changé, et pourquoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने के पहले हफ़्ते में ओवरव्यू पर एक छोटा नोट: क्या बदला, और क्यों।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve nota nella Panoramica nella prima settimana di ogni mese: cosa è cambiato e perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の最初の週に、概要に短いまとめを表示します。何がどう変わったのかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 첫 주에 개요에 표시되는 짧은 정리: 무엇이 왜 달라졌는지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte notitie op Overzicht in de eerste week van elke maand: wat er veranderde, en waarom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nota curta na Visão geral na primeira semana de cada mês: o que mudou e por quê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
