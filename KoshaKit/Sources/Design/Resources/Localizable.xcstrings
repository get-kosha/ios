    "settings_section_delete_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültige Aktionen. Jede fragt vorher nach, und ein Export vorab ist eine gute Idee."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent actions. Each one asks you to confirm, and an export first is a good idea."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones permanentes. Cada una te pide confirmación, y es buena idea exportar antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions définitives. Chacune demande confirmation, et il est conseillé d'exporter d'abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा के लिए होने वाले काम। हर एक के लिए पुष्टि माँगी जाती है, और पहले एक्सपोर्ट कर लेना अच्छा रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni definitive. Ognuna ti chiede conferma, ed è una buona idea esportare prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻せない操作です。どれも実行前に確認があります。先にエクスポートしておくことをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없는 작업이에요. 매번 확인을 요청하며, 먼저 내보내 두는 것이 좋아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitieve acties. Bij elke actie wordt om bevestiging gevraagd, en eerst exporteren is een goed idee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações permanentes. Cada uma pede confirmação, e é uma boa ideia exportar antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимые действия. Каждое требует подтверждения, и лучше сначала сделать экспорт."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不可撤销的操作。每项操作都需要你确认，建议先导出数据。"
          }
        }
      }
    },
