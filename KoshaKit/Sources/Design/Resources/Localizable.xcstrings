    "server_currency_locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ein Konto Buchungen hat, lässt sich seine Währung nicht mehr ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency can't change once an account has transactions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda no se puede cambiar cuando una cuenta ya tiene movimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise ne peut plus changer une fois que le compte a des opérations"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते में लेन-देन होने के बाद उसकी मुद्रा नहीं बदली जा सकती"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valuta non si può cambiare quando il conto ha già dei movimenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引がある口座の通貨は変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 있는 계좌는 통화를 바꿀 수 없어요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De valuta kan niet meer veranderen zodra een rekening transacties heeft"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A moeda não pode mudar depois que a conta tem transações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюту нельзя изменить, если на счёте уже есть операции"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "账户有交易后就不能更改货币"
          }
        }
      }
    },
    "server_entries_changed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Abgleichs haben sich Buchungen geändert. Lade die Seite neu und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some entries changed while you were reconciling. Reload and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos movimientos cambiaron mientras conciliabas. Recarga e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des opérations ont changé pendant le rapprochement. Rechargez et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलान करते समय कुछ एंट्रियाँ बदल गईं। पेज फिर से लोड करें और दोबारा कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni movimenti sono cambiati mentre riconciliavi. Ricarica e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合中に一部の取引が変更されました。再読み込みして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대조하는 동안 일부 거래가 바뀌었어요. 새로고침한 뒤 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn transacties veranderd terwijl je aan het afstemmen was. Laad opnieuw en probeer het nog eens."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns lançamentos mudaram enquanto você conciliava. Recarregue e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы проводили сверку, некоторые операции изменились. Перезагрузите страницу и попробуйте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你对账期间有交易发生了变化。请重新加载后再试。"
          }
        }
      }
    },
