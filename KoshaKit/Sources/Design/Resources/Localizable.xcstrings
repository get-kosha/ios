    "accounts_archived_checkbox": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviert {#muted}(in der Schnelleingabe ausgeblendet, zählt weiter zum Vermögen){/muted}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived {#muted}(hidden from quick entry, still counted in net worth){/muted}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivada {#muted}(oculta en la entrada rápida, sigue contando en el patrimonio neto){/muted}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivé {#muted}(masqué de la saisie rapide, toujours compté dans le patrimoine){/muted}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्काइव किया गया {#muted}(झटपट एंट्री में नहीं दिखेगा, पर नेट वर्थ में गिना जाएगा){/muted}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviato {#muted}(nascosto dall'aggiunta rapida, ancora conteggiato nel patrimonio netto){/muted}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済み {#muted}（クイック入力には表示されず、純資産には含まれます）{/muted}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 {#muted}(빠른 추가에서 숨겨지지만 순자산에는 포함돼요){/muted}"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gearchiveerd {#muted}(verborgen bij snel toevoegen, telt nog mee in je vermogen){/muted}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivada {#muted}(oculta na adição rápida, mas ainda conta no patrimônio){/muted}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В архиве {#muted}(скрыт из быстрого ввода, но учитывается в капитале){/muted}"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档 {#muted}（不在快速添加中显示，仍计入净资产）{/muted}"
          }
        }
      }
    },
