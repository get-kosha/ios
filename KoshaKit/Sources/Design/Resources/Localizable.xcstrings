    "settings_section_general_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache, Zeitzone und die Vorgaben, die Kosha beim Hinzufügen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language, time zone and the defaults Kosha uses when you add things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma, zona horaria y los valores predeterminados que usa Kosha cuando añades cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue, fuseau horaire et valeurs par défaut utilisées par Kosha quand vous ajoutez quelque chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
