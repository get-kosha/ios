    "settings_section_categories_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne die Kategorien deiner Buchungen um, verschachtle oder führe sie zusammen und ändere ihre Symbole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename, nest or merge the categories your transactions use, and change their icons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra, anida o fusiona las categorías que usan tus movimientos, y cambia sus iconos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommez, imbriquez ou fusionnez les catégories de vos opérations, et changez leurs icônes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लेन-देन की श्रेणियों का नाम बदलें, उन्हें एक-दूसरे के अंदर रखें या मर्ज करें, और उनके आइकन बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina, annida o unisci le categorie dei tuoi movimenti e cambiane le icone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引に使うカテゴリの名前変更、階層化、統合、アイコンの変更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래에 쓰는 카테고리의 이름을 바꾸거나, 하위로 넣거나, 합치고, 아이콘을 바꿔요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoem, nest of voeg de categorieën samen die je transacties gebruiken, en wijzig hun pictogrammen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeie, aninhe ou mescle as categorias das suas transações e troque os ícones delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовывайте, вкладывайте и объединяйте категории операций, меняйте их значки."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名、嵌套或合并交易使用的分类，并更换它们的图标。"
          }
        }
      }
    },
