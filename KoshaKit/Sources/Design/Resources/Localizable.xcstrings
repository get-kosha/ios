    "accounts_investment_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontostand ist das Geld, das du eingezahlt hast. Nutze ab und zu „Wertentwicklung aktualisieren“, um Kursgewinne in dein Vermögen aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance is the money you put in. Use \"Update gains\" from time to time to add market gains to your net worth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo es el dinero que has invertido. Usa «Actualizar rendimiento» de vez en cuando para sumar las ganancias del mercado a tu patrimonio neto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde correspond à l'argent que vous avez versé. Utilisez « Mettre à jour les plus-values » de temps en temps pour ajouter les gains du marché à votre patrimoine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैलेंस वह पैसा है जो आपने लगाया है। बाज़ार से हुए लाभ को नेट वर्थ में जोड़ने के लिए समय-समय पर \"रिटर्न अपडेट करें\" इस्तेमाल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è il denaro che hai versato. Usa ogni tanto \"Aggiorna rendimenti\" per aggiungere al patrimonio netto i guadagni di mercato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高は投入した金額です。ときどき「評価損益を更新」を使って、運用による損益を純資産に反映しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액은 투자한 원금이에요. 가끔 \"손익 업데이트\"로 시장 손익을 순자산에 반영하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo is het geld dat je erin hebt gestopt. Gebruik af en toe \"Rendement bijwerken\" om marktrendement aan je vermogen toe te voegen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo é o dinheiro que você aplicou. Use \"Atualizar rendimento\" de vez em quando para somar os ganhos de mercado ao seu patrimônio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс — это вложенные вами деньги. Время от времени нажимайте «Обновить прирост», чтобы добавить рыночный прирост к капиталу."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "余额是你投入的本金。不时使用“更新收益”，把市场收益计入净资产。"
          }
        }
      }
    },
