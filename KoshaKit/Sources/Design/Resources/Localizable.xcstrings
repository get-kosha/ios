        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金も一緒に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불도 함께 삭제돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De terugbetalingen worden ook verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os reembolsos também são apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
