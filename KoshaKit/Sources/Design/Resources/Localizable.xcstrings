    "settings_data_statements_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere CSV-, OFX- oder QFX-Dateien all deiner Banken und Karten auf einmal. Kosha legt die Konten an, ordnet die Zahlungspartner zu und gleicht jedes Konto mit seinem Kontoauszug ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import CSV, OFX or QFX files from all your banks and cards at once. Kosha sets up the accounts, sorts the payees and checks each account against its statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa de una vez archivos CSV, OFX o QFX de todos tus bancos y tarjetas. Kosha crea las cuentas, ordena los beneficiarios y comprueba cada cuenta con su extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des fichiers CSV, OFX ou QFX de toutes vos banques et cartes en une seule fois. Kosha crée les comptes, classe les tiers et rapproche chaque compte de son relevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी बैंक और कार्ड की CSV, OFX या QFX फ़ाइलें एक साथ इम्पोर्ट करें। Kosha खाते सेट अप करता है, पार्टियाँ छाँटता है और हर खाते को उसके स्टेटमेंट से मिलाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa insieme file CSV, OFX o QFX di tutte le tue banche e carte. Kosha crea i conti, ordina i beneficiari e confronta ogni conto con il suo estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての銀行とカードのCSV、OFX、QFXファイルをまとめてインポートできます。Koshaが口座を作成し、取引先を整理し、各口座を明細と照合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 은행과 카드의 CSV, OFX, QFX 파일을 한 번에 가져오세요. Kosha가 계좌를 만들고, 거래처를 정리하고, 각 계좌를 명세서와 대조해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer CSV-, OFX- of QFX-bestanden van al je banken en kaarten in één keer. Kosha maakt de rekeningen aan, sorteert de tegenpartijen en stemt elke rekening af met het afschrift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe arquivos CSV, OFX ou QFX de todos os seus bancos e cartões de uma vez. O Kosha cria as contas, organiza os favorecidos e confere cada conta com o extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте файлы CSV, OFX или QFX сразу по всем банкам и картам. Kosha создаст счета, разберёт контрагентов и сверит каждый счёт с его выпиской."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一次导入你所有银行和信用卡的 CSV、OFX 或 QFX 文件。Kosha 会设置账户、整理交易对象，并将每个账户与其对账单核对。"
          }
        }
      }
    },
    "settings_data_statements_desc_pdf": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere CSV-, OFX- oder QFX-Dateien oder PDF-Kontoauszüge all deiner Banken und Karten auf einmal. Kosha legt die Konten an, ordnet die Zahlungspartner zu und gleicht jedes Konto mit seinem Kontoauszug ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import CSV, OFX or QFX files or PDF statements from all your banks and cards at once. Kosha sets up the accounts, sorts the payees and checks each account against its statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa de una vez archivos CSV, OFX o QFX, o extractos en PDF, de todos tus bancos y tarjetas. Kosha crea las cuentas, ordena los beneficiarios y comprueba cada cuenta con su extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des fichiers CSV, OFX ou QFX ou des relevés PDF de toutes vos banques et cartes en une seule fois. Kosha crée les comptes, classe les tiers et rapproche chaque compte de son relevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी बैंक और कार्ड की CSV, OFX या QFX फ़ाइलें या PDF स्टेटमेंट एक साथ इम्पोर्ट करें। Kosha खाते सेट अप करता है, पार्टियाँ छाँटता है और हर खाते को उसके स्टेटमेंट से मिलाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa insieme file CSV, OFX o QFX o estratti conto in PDF di tutte le tue banche e carte. Kosha crea i conti, ordina i beneficiari e confronta ogni conto con il suo estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての銀行とカードのCSV、OFX、QFXファイルやPDFの明細をまとめてインポートできます。Koshaが口座を作成し、取引先を整理し、各口座を明細と照合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 은행과 카드의 CSV, OFX, QFX 파일이나 PDF 명세서를 한 번에 가져오세요. Kosha가 계좌를 만들고, 거래처를 정리하고, 각 계좌를 명세서와 대조해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer CSV-, OFX- of QFX-bestanden of pdf-afschriften van al je banken en kaarten in één keer. Kosha maakt de rekeningen aan, sorteert de tegenpartijen en stemt elke rekening af met het afschrift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe arquivos CSV, OFX ou QFX ou extratos em PDF de todos os seus bancos e cartões de uma vez. O Kosha cria as contas, organiza os favorecidos e confere cada conta com o extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте файлы CSV, OFX или QFX либо выписки в PDF сразу по всем банкам и картам. Kosha создаст счета, разберёт контрагентов и сверит каждый счёт с его выпиской."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一次导入你所有银行和信用卡的 CSV、OFX、QFX 文件或 PDF 对账单。Kosha 会设置账户、整理交易对象，并将每个账户与其对账单核对。"
          }
        }
      }
    },
