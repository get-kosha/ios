    "settings_sec_google_disconnect_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich dann nicht mehr mit Google anmelden. Deine anderen Anmeldemethoden funktionieren weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't be able to sign in with Google any more. Your other sign-in methods keep working."
