    "ask_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha sucht in deinen Konten, Buchungen und wiederkehrenden Zahlungen und zeigt, woher jede Antwort stammt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha looks it up in your accounts, transactions and recurring payments, and shows where each answer comes from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha lo busca en tus cuentas, movimientos y pagos recurrentes, y muestra de dónde sale cada respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha cherche dans vos comptes, opérations et paiements récurrents, et montre d'où vient chaque réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha आपके खातों, लेन-देन और नियमित भुगतानों में जवाब ढूँढता है, और बताता है कि हर जवाब कहाँ से आया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha cerca nei tuoi conti, movimenti e pagamenti ricorrenti, e mostra da dove viene ogni risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaが口座、取引、定期支払いを調べ、それぞれの回答の根拠を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 계좌, 거래, 정기 거래에서 찾아보고, 각 답변의 출처를 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha zoekt het op in je rekeningen, transacties en terugkerende betalingen, en laat zien waar elk antwoord vandaan komt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha consulta suas contas, transações e pagamentos recorrentes e mostra de onde vem cada resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ищет ответ в ваших счетах, операциях и регулярных платежах и показывает, откуда взят каждый ответ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 会在你的账户、交易和定期付款中查找，并显示每个答案的来源。"
          }
        }
      }
    },
