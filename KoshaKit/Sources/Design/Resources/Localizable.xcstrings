    "subs_adopt_description|one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die {count} bisherige Zahlung wird zugeordnet und erscheint im Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its {count} past payment is filed under it, so it shows in its history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su {count} pago anterior se archiva aquí, así que aparece en su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son paiement passé y est rattaché et apparaît donc dans son historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका पिछला {count} भुगतान इसके तहत दर्ज होगा, ताकि वह इसकी हिस्ट्री में दिखे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo {count} pagamento passato viene collegato, così compare nel suo storico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De {count} eerdere betaling wordt eronder geplaatst, zodat hij in de geschiedenis staat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O {count} pagamento anterior fica vinculado a ele e aparece no histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} прошлый платёж будет привязан к нему и появится в его истории."
          }
        }
      }
    },
    "subs_adopt_description|other": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die {count} bisherigen Zahlungen werden zugeordnet und erscheinen im Verlauf."
