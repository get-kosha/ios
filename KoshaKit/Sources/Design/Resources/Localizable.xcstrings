          "stringUnit": {
            "state": "translated",
            "value": "순자산에서는 갚아야 할 금액을 부채로 계산해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nettovermogen telt wat je verschuldigd bent als schuld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O patrimônio líquido conta o que você deve como dívida."
