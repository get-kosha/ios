    "auth_expired_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links zum Zurücksetzen funktionieren einmal und eine Stunde lang. Dein Passwort ist unverändert. Fordere einen neuen Link an und nimm die neueste E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset links work once, for one hour. Your password hasn't changed. Ask for a new link and use the newest email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de restablecimiento funcionan una vez y durante una hora. Tu contraseña no ha cambiado. Pide un enlace nuevo y usa el correo más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens de réinitialisation fonctionnent une fois, pendant une heure. Votre mot de passe n'a pas changé. Demandez un nouveau lien et utilisez l'e-mail le plus récent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीसेट लिंक एक घंटे के लिए, एक ही बार काम करते हैं। आपका पासवर्ड नहीं बदला है। नया लिंक माँगें और सबसे नया ईमेल इस्तेमाल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link di reimpostazione funzionano una volta, per un'ora. La tua password non è cambiata. Chiedi un nuovo link e usa l'email più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再設定リンクは1回だけ、1時間以内に使えます。パスワードは変更されていません。新しいリンクをリクエストし、最新のメールにあるリンクを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설정 링크는 1시간 동안 한 번만 쓸 수 있어요. 비밀번호는 바뀌지 않았어요. 새 링크를 요청하고 가장 최근 이메일을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetlinks werken één keer, een uur lang. Je wachtwoord is niet veranderd. Vraag een nieuwe link aan en gebruik de nieuwste e-mail."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links de redefinição funcionam uma vez, por uma hora. Sua senha não mudou. Peça um novo link e use o e-mail mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка для сброса срабатывает один раз и действует один час. Ваш пароль не изменился. Запросите новую ссылку и откройте самое свежее письмо."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "重置链接只能使用一次，有效期一小时。你的密码没有改变。请申请新链接，并使用最新的那封邮件。"
          }
        }
      }
    },
