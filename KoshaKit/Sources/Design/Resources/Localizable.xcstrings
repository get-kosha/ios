    "tx_transfer_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt Geld zwischen deinen Konten. Das zählt nicht als Ausgabe oder Einnahme, die Gebühr aber schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves money between your accounts. It doesn't count as spending or income, but the fee does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve dinero entre tus cuentas. No cuenta como gasto ni como ingreso, pero la comisión sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace de l'argent entre vos comptes. Cela ne compte ni comme une dépense ni comme un revenu, mais les frais, si."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने खातों के बीच पैसा भेजता है। इसे खर्च या आय में नहीं गिना जाता, लेकिन शुल्क को गिना जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta denaro tra i tuoi conti. Non conta come spesa né come entrata, ma la commissione sì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の口座間でお金を移動します。支出にも収入にも計上されませんが、手数料は計上されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계좌끼리 돈을 옮겨요. 지출이나 수입으로 계산되지 않지만, 수수료는 지출로 계산돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst geld tussen je eigen rekeningen. Telt niet als uitgave of inkomsten, maar de kosten wel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move dinheiro entre as suas contas. Não conta como despesa nem receita, mas a taxa conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещает деньги между вашими счетами. Не считается ни расходом, ни доходом, а вот комиссия считается."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的账户之间转移资金。转账不计入支出或收入，但手续费计入支出。"
          }
        }
      }
    },
