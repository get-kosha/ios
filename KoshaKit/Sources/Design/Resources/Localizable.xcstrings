            "value": "그동안 이 휴대폰에서는 코드를 묻지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot die tijd vraagt Kosha op deze telefoon niet om een code."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha não vai pedir um código neste celular até lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До тех пор Kosha не будет спрашивать код на этом телефоне."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在此期间，Kosha 不会在这台手机上要求输入验证码。"
          }
        }
      }
    },
