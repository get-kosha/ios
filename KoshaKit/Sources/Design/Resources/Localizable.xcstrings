    "auth_demo_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dir alles ansehen. Hinzufügen, Bearbeiten und Löschen sind ausgeschaltet, damit die nächste Person alles so sieht wie du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can open everything. Adding, editing and deleting are turned off, so the next person sees it as you did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes abrirlo todo. Añadir, editar y eliminar están desactivados, para que la siguiente persona lo vea igual que tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez tout ouvrir. L'ajout, la modification et la suppression sont désactivés, pour que la personne suivante la voie comme vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सब कुछ खोल सकते हैं। जोड़ना, बदलना और हटाना बंद है, ताकि अगले व्यक्ति को यह वैसा ही दिखे जैसा आपको दिखा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aprire tutto. Aggiungere, modificare ed eliminare sono disattivati, così la prossima persona la vede come l'hai vista tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての画面を開けます。追加・編集・削除はできないため、次の人もあなたと同じ状態で見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 화면을 열어 볼 수 있어요. 다음 사람도 똑같이 볼 수 있도록 추가, 편집, 삭제는 꺼져 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alles openen. Toevoegen, bewerken en verwijderen staan uit, zodat de volgende het ziet zoals jij het zag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode abrir tudo. Adicionar, editar e excluir estão desativados, para que a próxima pessoa veja tudo como você viu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть можно всё. Добавление, изменение и удаление отключены, чтобы следующий посетитель увидел всё так же, как вы."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "所有页面都可以打开。添加、编辑和删除功能已关闭，这样下一位访客看到的和你看到的一样。"
          }
        }
      }
    },
    "auth_demo_own_account": {
