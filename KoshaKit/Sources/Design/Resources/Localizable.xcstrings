    "site_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse jede Zahlung in wenigen Sekunden und sieh dann, wo der Monat geblieben ist. Ein kostenloser Open-Source-Finanztracker für alle deine Konten, in jeder Währung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add each payment in a few seconds, then see where the month went. A free, open-source personal finance tracker for every account, in any currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota cada pago en unos segundos y luego mira en qué se fue el mes. Una herramienta de finanzas personales gratuita y de código abierto para todas tus cuentas, en cualquier moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez chaque paiement en quelques secondes, puis voyez où est passé votre mois. Un outil de suivi des finances personnelles gratuit et open source, pour tous vos comptes, dans toutes les devises."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर भुगतान कुछ ही सेकंड में जोड़ें, फिर देखें कि महीने का पैसा कहाँ गया। हर खाते और हर मुद्रा के लिए एक मुफ़्त, ओपन-सोर्स पर्सनल फ़ाइनेंस ट्रैकर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ogni pagamento in pochi secondi, poi scopri dove è finito il mese. Un'app gratuita e open source per le finanze personali, per tutti i tuoi conti e in qualsiasi valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いは数秒で記録、月末にはお金の行き先がひと目でわかります。すべての口座、あらゆる通貨に対応した、無料でオープンソースの家計管理アプリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제할 때마다 몇 초 만에 기록하고, 한 달 동안 돈이 어디로 갔는지 확인하세요. 모든 계좌와 모든 통화를 지원하는 무료 오픈소스 가계부예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg elke betaling in een paar seconden toe en zie waar je maand gebleven is. Een gratis, open-source app om je financiën bij te houden, voor elke rekening en in elke valuta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cada pagamento em poucos segundos e veja para onde foi o mês. Um app de finanças pessoais gratuito e de código aberto para todas as suas contas, em qualquer moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте каждый платёж за пару секунд и смотрите, куда ушли деньги за месяц. Бесплатный трекер личных финансов с открытым исходным кодом — для любых счетов и в любой валюте."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔收支几秒钟记完，月底一眼看清钱花在了哪里。一款免费、开源的个人记账工具，支持所有账户和任意货币。"
          }
        }
      }
    },
    "site_landing_title": {
