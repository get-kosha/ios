    "auth_error_passkey": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey hat nicht funktioniert. Versuch es noch mal oder nimm dein Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That passkey didn't work. Try again, or use your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa llave de acceso no funcionó. Inténtalo de nuevo o usa tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé d'accès n'a pas fonctionné. Réessayez ou utilisez votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पासकी नहीं चली। फिर से कोशिश करें, या अपना पासवर्ड इस्तेमाल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey non ha funzionato. Riprova o usa la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーで認証できませんでした。もう一度試すか、パスワードを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키가 작동하지 않았어요. 다시 시도하거나 비밀번호를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die passkey werkte niet. Probeer het opnieuw, of gebruik je wachtwoord."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa chave de acesso não funcionou. Tente de novo ou use sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ доступа не сработал. Попробуйте ещё раз или войдите с паролем."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该通行密钥无效。请重试，或使用密码。"
          }
        }
