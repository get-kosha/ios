          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrato nel menu e in tutto ciò che esporti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューやエクスポートしたデータに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴와 내보낸 모든 파일에 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getoond in het menu en op alles wat je exporteert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no menu e em tudo o que você exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в меню и во всём, что вы экспортируете."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在菜单和你导出的任何内容中。"
          }
