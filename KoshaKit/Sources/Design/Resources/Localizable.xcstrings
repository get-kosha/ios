    "settings_section_security_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter, Passkeys, Zwei-Faktor und die Geräte, die bei deinem Kosha-Konto angemeldet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords, passkeys, two-factor and the devices signed in to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseñas, llaves de acceso, verificación en dos pasos y los dispositivos con sesión iniciada en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots de passe, clés d'accès, double authentification et appareils connectés à votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड, पासकी, टू-फ़ैक्टर और आपके अकाउंट में साइन-इन वाले डिवाइस।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Password, passkey, autenticazione a due fattori e dispositivi connessi al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード、パスキー、2段階認証、アカウントにログイン中のデバイス。"
