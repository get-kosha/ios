    "app_add_why_expense": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha kann noch keine erraten. Wähl sie aus, und die Ausgabe wird hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha can't guess one yet. Pick it and the expense is added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha aún no puede adivinarla. Elígela y se añade el gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ne peut pas encore la deviner. Choisissez-la et la dépense est ajoutée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha अभी श्रेणी का अंदाज़ा नहीं लगा सकता। श्रेणी चुनें और खर्च जुड़ जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha non può ancora indovinarla. Sceglila e la spesa viene aggiunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaはまだカテゴリを推測できません。選ぶと支出が追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 아직 카테고리를 추측할 수 없어요. 고르면 지출이 추가돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha kan er nog geen raden. Kies er een en de uitgave wordt toegevoegd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha ainda não consegue adivinhar. Escolha uma e a despesa é adicionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha пока не может угадать категорию. Выберите её, и расход добавится."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 还猜不出分类。选择一个分类，这笔支出就会添加。"
          }
        }
      }
    },
