    "app_month_swipe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische in Übersicht, Aktivität oder Wiederkehrend seitwärts, um einen Monat weiterzugehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe Overview, Activity or Recurring sideways to move one month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza Resumen, Actividad o Recurrentes hacia un lado para moverte un mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez Aperçu, Activité ou Récurrents sur le côté pour changer de mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक महीना आगे-पीछे जाने के लिए ओवरव्यू, गतिविधि या आवर्ती को बगल में स्वाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri di lato Panoramica, Attività o Ricorrenti per spostarti di un mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要・アクティビティ・定期を横にスワイプすると 1 か月移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개요, 내역, 정기 거래 화면을 옆으로 밀면 한 달씩 이동해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg in Overzicht, Activiteit of Terugkerend opzij om een maand te verschuiven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize Visão geral, Atividade ou Recorrentes para o lado para mudar de mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите вбок на экранах «Обзор», «Операции» или «Регулярные», чтобы сменить месяц."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在概览、明细或定期页面左右滑动可切换一个月。"
          }
        }
      }
    },
