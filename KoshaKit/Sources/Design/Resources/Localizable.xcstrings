    "auth_agree": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Erstellen eines Kontos stimmst du den {#terms}Nutzungsbedingungen{/terms} und der {#privacy}Datenschutzerklärung{/privacy} zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By creating an account you agree to the {#terms}terms{/terms} and {#privacy}privacy policy{/privacy}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al crear una cuenta aceptas los {#terms}términos{/terms} y la {#privacy}política de privacidad{/privacy}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En créant un compte, vous acceptez les {#terms}conditions d'utilisation{/terms} et la {#privacy}politique de confidentialité{/privacy}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकाउंट बनाकर आप {#terms}शर्तों{/terms} और {#privacy}गोपनीयता नीति{/privacy} से सहमत होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando un account accetti i {#terms}termini di servizio{/terms} e l'{#privacy}informativa sulla privacy{/privacy}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成すると、{#terms}利用規約{/terms}と{#privacy}プライバシーポリシー{/privacy}に同意したことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 만들면 {#terms}이용약관{/terms} 및 {#privacy}개인정보 처리방침{/privacy}에 동의하게 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door een account aan te maken ga je akkoord met de {#terms}voorwaarden{/terms} en het {#privacy}privacybeleid{/privacy}."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao criar uma conta, você concorda com os {#terms}termos de uso{/terms} e a {#privacy}política de privacidade{/privacy}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавая аккаунт, вы принимаете {#terms}условия использования{/terms} и {#privacy}политику конфиденциальности{/privacy}."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "创建账号即表示你同意{#terms}服务条款{/terms}和{#privacy}隐私政策{/privacy}。"
          }
        }
      }
    },
    "auth_app_callback_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Browser hat diese Seite statt der Kosha-App geöffnet. Fahre nur fort, wenn du dich gerade in der Kosha-App auf diesem Handy angemeldet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser opened this page instead of the Kosha app. Continue only if you just signed in from the Kosha app on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu navegador abrió esta página en lugar de la app de Kosha. Continúa solo si acabas de iniciar sesión desde la app de Kosha en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre navigateur a ouvert cette page au lieu de l'app Kosha. Continuez seulement si vous venez de vous connecter depuis l'app Kosha sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ब्राउज़र ने Kosha ऐप की जगह यह पेज खोला है। आगे तभी बढ़ें जब आपने अभी इस फ़ोन पर Kosha ऐप से साइन इन किया हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il browser ha aperto questa pagina invece dell'app Kosha. Continua solo se hai appena effettuato l'accesso dall'app Kosha su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaアプリの代わりにブラウザでこのページが開きました。このスマートフォンのKoshaアプリからサインインしたばかりの場合のみ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저가 Kosha 앱 대신 이 페이지를 열었어요. 방금 이 휴대폰의 Kosha 앱에서 로그인한 경우에만 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je browser opende deze pagina in plaats van de Kosha-app. Ga alleen verder als je net bent ingelogd vanuit de Kosha-app op deze telefoon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu navegador abriu esta página em vez do app Kosha. Continue só se você acabou de entrar pelo app Kosha neste celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер открыл эту страницу вместо приложения Kosha. Продолжайте, только если вы только что вошли из приложения Kosha на этом телефоне."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器打开了此页面，而不是 Kosha 应用。只有在你刚刚从这部手机上的 Kosha 应用登录时才继续。"
          }
        }
      }
    },
