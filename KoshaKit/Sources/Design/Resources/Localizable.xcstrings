    "settings_cat_archived_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Auswahllisten ausgeblendet, bisherige Buchungen behalten sie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden from pickers; past transactions keep them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultas en los selectores; los movimientos anteriores las conservan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquées des sélecteurs ; les opérations passées les conservent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनने वाली सूचियों में नहीं दिखतीं; पिछले लेन-देन में बनी रहती हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascoste dalle selezioni; i movimenti passati le mantengono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択肢には表示されません。過去の取引ではそのまま使われます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 목록에서는 숨겨지지만 지난 거래에는 남아 있어요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen in keuzelijsten; eerdere transacties houden ze"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultas nos seletores; as transações anteriores as mantêm"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыты из списков выбора; в прошлых операциях остаются"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不在选择列表中显示；过去的交易仍保留它们"
          }
        }
      }
    },
