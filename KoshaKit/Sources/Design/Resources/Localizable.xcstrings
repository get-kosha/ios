    "settings_section_events_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen und Anlässe, die Buchungen bündeln, damit du siehst, was jedes davon gekostet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips and occasions that group transactions, so you can see what each one cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes y ocasiones que agrupan movimientos, para que veas cuánto costó cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyages et occasions qui regroupent des opérations, pour voir ce que chacun a coûté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रिप और मौके जो लेन-देन को एक साथ रखते हैं, ताकि आप देख सकें कि हर एक में कितना लगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaggi e occasioni che raggruppano i movimenti, così vedi quanto è costato ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引をまとめる旅行や行事。それぞれにかかった費用がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 묶는 여행이나 행사. 각각 얼마나 들었는지 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reizen en gelegenheden die transacties groeperen, zodat je ziet wat elk ervan kostte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagens e ocasiões que agrupam transações, para você ver quanto cada uma custou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездки и поводы, объединяющие операции, чтобы видеть, во что обошёлся каждый."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用旅行和特殊场合来归组交易，看看每一项花了多少。"
          }
        }
      }
    },
