    "settings_sec_password_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 10 Zeichen. Eine Änderung meldet deine anderen Geräte ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 10 characters. Changing it signs out your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 10 caracteres. Al cambiarla se cierra la sesión en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 10 caractères. Le modifier déconnecte vos autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 10 अक्षर। इसे बदलने पर आपके दूसरे डिवाइस साइन आउट हो जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 10 caratteri. Cambiandola esci dagli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10文字以上。変更すると、ほかのデバイスはログアウトされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10자 이상. 바꾸면 다른 기기에서 로그아웃돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens 10 tekens. Als je het wijzigt, word je op je andere apparaten uitgelogd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 10 caracteres. Alterá-la desconecta seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не меньше 10 символов. При смене пароля выполняется выход на других устройствах."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 10 个字符。修改后，你的其他设备会退出登录。"
          }
        }
      }
    },
    "settings_sec_password_description_none": {
      "extractionState": "manual",
      "localizations": {
