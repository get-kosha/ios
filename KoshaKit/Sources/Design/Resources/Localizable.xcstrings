    "auth_2fa_trust_browser": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dahin fragt Kosha in diesem Browser nicht nach einem Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha won't ask for a code on this browser until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta entonces, Kosha no te pedirá ningún código en este navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ne demandera pas de code sur ce navigateur d'ici là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब तक Kosha इस ब्राउज़र पर कोड नहीं माँगेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora Kosha non chiederà un codice su questo browser."
          }
