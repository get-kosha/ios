    "tx_delete_reconciled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist abgeglichen, daher stimmt das Konto danach nicht mehr mit dem Kontoauszug überein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's reconciled, so the account will no longer match that statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está conciliado, así que la cuenta dejará de coincidir con ese extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est rapprochée : le compte ne correspondra plus à ce relevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका मिलान हो चुका है, इसलिए खाता अब उस स्टेटमेंट से मेल नहीं खाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È riconciliato, quindi il conto non corrisponderà più a quell'estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合済みのため、口座がその明細と一致しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대조 완료된 거래라서, 삭제하면 계좌가 해당 명세서와 더 이상 일치하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij is afgestemd, dus de rekening klopt dan niet meer met dat afschrift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela está conciliada, então a conta não vai mais bater com aquele extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция сверена, поэтому счёт перестанет совпадать с той выпиской."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它已对账，删除后账户将与那份对账单对不上。"
          }
        }
      }
    },
    "tx_delete_refunds": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Erstattungen werden ebenfalls gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
