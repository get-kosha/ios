    "settings_ai_quick_add_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib „Mittagessen mit Sam beim Italiener 18,50 gestern“ in die Schnelleingabe oder tippe auf dem Handy beim Hinzufügen auf ✦, und Kosha füllt das Formular aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type \"lunch with Sam at Nando's 18.50 yesterday\" in quick add, or tap ✦ on the phone add screen, and Kosha fills the form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe «comida con Sam en Nando's 18,50 ayer» en la entrada rápida, o toca ✦ en la pantalla de añadir del móvil, y Kosha rellena el formulario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez « déjeuner avec Sam chez Nando's 18,50 hier » dans la saisie rapide, ou touchez ✦ sur l'écran d'ajout du téléphone, et Kosha remplit le formulaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झटपट जोड़ें में \"कल Sam के साथ Nando's में लंच 18.50\" लिखें, या फ़ोन की जोड़ने वाली स्क्रीन पर ✦ टैप करें, और Kosha फ़ॉर्म भर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi \"pranzo con Sam da Nando's 18,50 ieri\" nell'aggiunta rapida, oppure tocca ✦ nella schermata di aggiunta sul telefono, e Kosha compila il modulo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック入力に「昨日 佐藤さんとランチ 1800」と入力するか、スマホの追加画面で ✦ をタップすると、Koshaがフォームを埋めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 추가에 \"어제 Sam이랑 Nando's에서 점심 18.50\"처럼 입력하거나 휴대폰 추가 화면에서 ✦를 탭하면 Kosha가 양식을 채워요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ “lunch met Sam bij Nando's 18,50 gisteren” bij snel toevoegen, of tik op ✦ op het toevoegscherm van je telefoon, en Kosha vult het formulier in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite \"almoço com a Sam no Nando's 18,50 ontem\" na adição rápida, ou toque em ✦ na tela de adicionar do celular, e o Kosha preenche o formulário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите в быстрый ввод «обед с Сашей в кафе 18.50 вчера» или нажмите ✦ на экране добавления на телефоне, и Kosha заполнит форму."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速添加中输入“昨天和小王在 Nando's 吃午饭 18.50”，或在手机添加页面点按 ✦，Kosha 就会填好表单。"
          }
        }
      }
    },
