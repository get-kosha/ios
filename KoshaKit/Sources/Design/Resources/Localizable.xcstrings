          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のKoshaの未払い残高は{#amount}{amount}{/amount}です。銀行の利用可能額ではなく、現在の残高と比べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 Kosha에 표시된 미결제 금액: {#amount}{amount}{/amount}. 은행의 사용 가능 금액이 아니라 현재 잔액과 비교하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgens Kosha sta je vandaag {#amount}{amount}{/amount} open. Vergelijk dat met het huidige saldo bij je bank, niet met het beschikbare saldo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha mostra que você deve {#amount}{amount}{/amount} hoje. Compare com o saldo atual do seu banco, não com o disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня Kosha показывает задолженность {#amount}{amount}{/amount}. Сравните с текущим балансом в банке, а не с доступным."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 显示你今天欠款 {#amount}{amount}{/amount}。请与银行的当前余额比较，而不是可用余额。"
          }
        }
      }
    },
