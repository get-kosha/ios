    "accounts_reconcile_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak die Buchungen auf deinem Kontoauszug ab oder importiere ihn, und Kosha findet, was fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick entries off your statement, or import it, and Kosha finds what's missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca los movimientos de tu extracto, o impórtalo, y Kosha encuentra lo que falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les opérations de votre relevé, ou importez-le, et Kosha trouve ce qui manque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने स्टेटमेंट से एंट्रियाँ टिक करें, या उसे इम्पोर्ट करें, और Kosha बताएगा कि क्या छूटा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta i movimenti del tuo estratto conto, oppure importalo, e Kosha trova cosa manca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細と見比べて取引にチェックを付けるか、明細をインポートすると、足りない取引をKoshaが見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명세서와 거래를 하나씩 체크하거나 명세서를 가져오면, 빠진 거래를 Kosha가 찾아 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink transacties af op je afschrift, of importeer het, en Kosha vindt wat er ontbreekt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os lançamentos do seu extrato, ou importe-o, e o Kosha encontra o que está faltando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте операции по выписке или импортируйте её — Kosha найдёт, чего не хватает."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "对照对账单逐笔勾选，或直接导入对账单，Kosha 会找出缺少的交易。"
          }
        }
      }
    },
