    "app_set_currencies_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten und ziehen zum Sortieren. Die oberste ist deine Hauptwährung: Vermögen und Summen werden darin berechnet. Der Währungsschalter oben in der Übersicht geht sie in dieser Reihenfolge durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold and drag to reorder. The one on top is your default, so net worth and totals add up in it. The currency switch at the top of Overview steps through them in this order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado y arrastra para reordenar. La de arriba es tu moneda principal, así que el patrimonio neto y los totales se suman en ella. El selector de moneda de Resumen las recorre en este orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement et faites glisser pour réordonner. Celle du haut est votre devise principale : le patrimoine et les totaux sont calculés dans celle-ci. Le sélecteur de devise en haut de l'Aperçu les parcourt dans cet ordre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए दबाकर खींचें। सबसे ऊपर वाली आपकी मुख्य मुद्रा है, इसलिए नेट वर्थ और जोड़ इसी में होते हैं। ओवरव्यू के ऊपर का मुद्रा स्विच इन्हें इसी क्रम में बदलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto e trascina per riordinare. Quella in alto è la tua valuta principale, quindi patrimonio netto e totali si sommano in essa. Il selettore di valuta in cima alla Panoramica le scorre in questo ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しして並べ替えます。一番上がメイン通貨で、純資産と合計はこの通貨で計算されます。概要の上部にある通貨切り替えは、この順番で切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌러 끌면 순서를 바꿀 수 있어요. 맨 위가 기본 통화라서 순자산과 합계가 이 통화로 계산돼요. 개요 상단의 통화 전환은 이 순서대로 바뀌어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt en sleep om de volgorde te wijzigen. De bovenste is je hoofdvaluta, dus vermogen en totalen worden daarin opgeteld. De valutaknop bovenaan Overzicht doorloopt ze in deze volgorde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure para arrastar e reordenar. A do topo é a sua moeda principal, então o patrimônio e os totais somam nela. O seletor de moeda no topo da Visão geral passa por elas nesta ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и перетащите, чтобы изменить порядок. Верхняя — основная валюта: в ней считаются капитал и итоги. Переключатель валюты вверху Обзора перебирает их в этом порядке."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "长按并拖动以调整顺序。最上面的是主货币，净资产和合计都以它计算。概览顶部的货币切换会按此顺序切换。"
          }
        }
      }
    },
