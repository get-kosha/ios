    "email_reset_footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst diese E-Mail, weil für dein Kosha-Konto ein neues Passwort angefordert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
