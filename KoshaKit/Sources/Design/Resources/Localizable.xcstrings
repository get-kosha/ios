    "settings_profile_no_storage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server hat keinen Speicher für Fotos. Dafür braucht er Cloudflare R2; wie du das einschaltest, steht in der README."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server has no storage for photos. It needs Cloudflare R2, which the README explains how to turn on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no tiene almacenamiento para fotos. Necesita Cloudflare R2; el README explica cómo activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n'a pas de stockage pour les photos. Il lui faut Cloudflare R2, dont le README explique l'activation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर पर फ़ोटो के लिए स्टोरेज नहीं है। इसके लिए Cloudflare R2 चाहिए, जिसे चालू करने का तरीका README में दिया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non ha uno spazio di archiviazione per le foto. Serve Cloudflare R2, e il README spiega come attivarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーには写真の保存先がありません。Cloudflare R2が必要です。有効にする方法はREADMEで説明しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에는 사진 저장소가 없어요. Cloudflare R2가 필요하며, 켜는 방법은 README에 나와 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server heeft geen opslag voor foto's. Daarvoor is Cloudflare R2 nodig; in de README staat hoe je dat aanzet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não tem armazenamento para fotos. Ele precisa do Cloudflare R2, e o README explica como ativá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом сервере нет хранилища для фото. Нужен Cloudflare R2 — как его включить, описано в README."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器没有用于存储照片的空间。需要 Cloudflare R2，README 中说明了如何开启。"
          }
        }
      }
    },
