    "import_sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ordnet deine Kontoauszüge den Konten zu. Prüf jedes Konto, danach die Zahlungspartner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha sorts your statements into accounts. Check each one, then the payees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha reparte tus extractos en cuentas. Revisa cada una y después los beneficiarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha répartit vos relevés par compte. Vérifiez chacun, puis les tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha आपके स्टेटमेंट को खातों में बाँटता है। हर खाता जाँचें, फिर पार्टियाँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha smista i tuoi estratti conto nei conti. Controlla ciascuno, poi i beneficiari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaが明細を口座ごとに振り分けます。各口座を確認してから、取引先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 명세서를 계좌별로 정리해요. 각 계좌를 확인한 다음 거래처를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha verdeelt je afschriften over rekeningen. Controleer ze een voor een, en daarna de tegenpartijen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha organiza seus extratos em contas. Confira cada uma e depois os favorecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha распределит выписки по счетам. Проверьте каждый счёт, затем контрагентов."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 会把你的对账单归入各个账户。逐个检查账户，再检查交易对象。"
          }
        }
      }
    },
