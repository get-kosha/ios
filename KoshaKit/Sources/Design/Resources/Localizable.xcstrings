    "tx_reconciled_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Kontoauszug abgeglichen. Änderst du Betrag oder Konto, musst du sie beim nächsten Abgleich erneut prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconciled with a bank statement. Changing its amount or account means checking it again next time you reconcile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conciliado con un extracto bancario. Si cambias su importe o su cuenta, tendrás que volver a comprobarlo la próxima vez que concilies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochée avec un relevé bancaire. Modifier son montant ou son compte impose de la vérifier à nouveau lors du prochain rapprochement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक स्टेटमेंट से मिलान हो चुका है। इसकी रकम या खाता बदलने पर अगली बार मिलान करते समय इसे फिर से जाँचना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconciliato con un estratto conto. Se ne cambi l'importo o il conto, dovrai ricontrollarlo alla prossima riconciliazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行の明細と照合済みです。金額や口座を変更すると、次回の照合で再確認が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 명세서와 대조한 거래예요. 금액이나 계좌를 바꾸면 다음 대조 때 다시 확인해야 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgestemd met een bankafschrift. Als je het bedrag of de rekening wijzigt, moet je hem bij de volgende afstemming opnieuw controleren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conciliada com um extrato bancário. Se você alterar o valor ou a conta, ela precisará ser conferida de novo na próxima conciliação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверено с банковской выпиской. Если изменить сумму или счёт, операцию придётся проверить снова при следующей сверке."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已与银行对账单对账。修改金额或账户后，下次对账时需要重新核对。"
          }
        }
      }
    },
