        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에 표시된 잔액을 입력하면 보정돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het saldo in dat je bank laat zien om het te corrigeren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o saldo que o seu banco mostra para corrigi-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
