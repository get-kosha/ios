    "settings_rules_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln. Speichere eine Buchung, dann lernt Kosha eine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Save a transaction and Kosha learns one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reglas. Guarda un movimiento y Kosha aprenderá una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle pour l'instant. Enregistrez une opération et Kosha en apprend une."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई नियम नहीं। कोई लेन-देन सेव करें और Kosha एक नियम सीख लेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna regola. Salva un movimento e Kosha ne impara una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはまだありません。取引を保存すると、Koshaがルールを学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 규칙이 없어요. 거래를 저장하면 Kosha가 규칙을 학습해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen regels. Sla een transactie op en Kosha leert er een."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma regra ainda. Salve uma transação e o Kosha aprende uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет. Сохраните операцию, и Kosha выучит первое."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有规则。保存一笔交易，Kosha 就会学到一条。"
          }
        }
      }
    },
