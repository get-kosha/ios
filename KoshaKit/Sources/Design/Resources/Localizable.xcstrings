    "settings_report_issue_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Issues von Kosha auf GitHub. Dort kannst du einen Fehler melden oder eine Idee vorschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Kosha's issues on GitHub, where you can report a bug or suggest an idea."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las incidencias de Kosha en GitHub, donde puedes informar de un error o proponer una idea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les tickets de Kosha sur GitHub, où vous pouvez signaler un bug ou proposer une idée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर Kosha के issues खोलता है, जहाँ आप कोई गड़बड़ी बता सकते हैं या कोई सुझाव दे सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le issue di Kosha su GitHub, dove puoi segnalare un bug o proporre un'idea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubのKoshaのissueを開きます。不具合の報告やアイデアの提案ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 Kosha 이슈를 열어요. 버그를 신고하거나 아이디어를 제안할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de issues van Kosha op GitHub, waar je een fout kunt melden of een idee kunt voorstellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as issues do Kosha no GitHub, onde você pode relatar um bug ou sugerir uma ideia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает issues Kosha на GitHub, где можно сообщить об ошибке или предложить идею."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Kosha 在 GitHub 上的 issue 页面，你可以在那里报告错误或提出建议。"
          }
        }
      }
    },
