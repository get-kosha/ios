        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado. Este app vai se conectar só com leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено. Приложение подключится только для чтения."
