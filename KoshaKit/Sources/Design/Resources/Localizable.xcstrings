    "settings_ai_ask_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen zu deinem Geld, beantwortet aus deinen Daten, mit Links zu den Buchungen hinter jeder Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions about your money, answered from your data, with links to the entries behind each answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas sobre tu dinero, respondidas a partir de tus datos, con enlaces a los movimientos en los que se basa cada respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos questions sur votre argent, avec des réponses tirées de vos données et des liens vers les opérations à l'origine de chaque réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पैसे से जुड़े सवाल, आपके डेटा से जवाब, हर जवाब के पीछे की एंट्रियों के लिंक के साथ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande sui tuoi soldi, con risposte basate sui tuoi dati e i link ai movimenti dietro ogni risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金についての質問に、あなたのデータから回答します。各回答には根拠となった取引へのリンクが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 돈에 관한 질문에 내 데이터로 답하고, 답변마다 근거가 된 거래 링크를 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen over je geld, beantwoord op basis van je gegevens, met links naar de transacties achter elk antwoord."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas sobre o seu dinheiro, respondidas com os seus dados, com links para os lançamentos por trás de cada resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы о ваших деньгах с ответами по вашим данным и ссылками на операции, на которых основан каждый ответ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关于你的钱的问题，根据你的数据回答，并附上每个答案所依据交易的链接。"
          }
        }
      }
    },
    "settings_ai_ask_sends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
