          "stringUnit": {
            "state": "translated",
            "value": "आपका अकाउंट और उसके सभी लेन-देन, खाते, श्रेणियाँ और नियमित भुगतान हट जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il tuo account e ogni movimento, conto, categoria e pagamento ricorrente che contiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと、その中のすべての取引、口座、カテゴリ、定期支払いを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 그 안의 모든 거래, 계좌, 카테고리, 정기 거래를 삭제해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je account en elke transactie, rekening, categorie en terugkerende betaling erin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove sua conta Kosha e todas as transações, contas, categorias e pagamentos recorrentes nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ваш аккаунт и все операции, счета, категории и регулярные платежи в нём."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "移除你的 Kosha 账号及其中的所有交易、账户、分类和定期付款。"
          }
        }
      }
    },
