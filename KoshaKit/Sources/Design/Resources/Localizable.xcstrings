    "settings_section_ai_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Hilfe von einem Modell deiner Wahl. Kosha funktioniert auch ganz ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional help from a model you choose. Kosha works fully without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda opcional de un modelo que tú eliges. Kosha funciona completamente sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une aide facultative d'un modèle de votre choix. Kosha fonctionne entièrement sans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए मॉडल से वैकल्पिक मदद। Kosha इसके बिना भी पूरी तरह काम करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aiuto facoltativo da un modello a tua scelta. Kosha funziona pienamente anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが選んだモデルによる任意のサポートです。AIなしでもKoshaのすべての機能を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 고른 모델의 도움을 선택적으로 받아요. AI 없이도 Kosha의 모든 기능을 쓸 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele hulp van een model naar keuze. Kosha werkt ook volledig zonder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda opcional de um modelo que você escolhe. O Kosha funciona totalmente sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательная помощь от выбранной вами модели. Kosha полностью работает и без неё."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "由你选择的模型提供的可选帮助。不使用它，Kosha 也能完整运行。"
          }
        }
      }
    },
