    "settings_api_disconnect_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff endet sofort. Um sie wieder zu nutzen, verbinde sie in der App und melde dich an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It loses access straight away. To use it again, connect it from the app and sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierde el acceso de inmediato. Para volver a usarla, conéctala desde la app e inicia sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle perd l'accès immédiatement. Pour l'utiliser à nouveau, connectez-la depuis l'app et connectez-vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी पहुँच तुरंत खत्म हो जाएगी। इसे फिर से इस्तेमाल करने के लिए, ऐप से कनेक्ट करें और साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perde subito l'accesso. Per usarla di nuovo, collegala dall'app ed effettua l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにアクセスできなくなります。再び使うには、アプリから接続してログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 접근 권한을 잃어요. 다시 쓰려면 앱에서 연결하고 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app verliest meteen de toegang. Om hem weer te gebruiken, koppel je hem vanuit de app en log je in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele perde o acesso na hora. Para usá-lo de novo, conecte pelo app e entre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ пропадёт сразу. Чтобы снова пользоваться, подключите его из приложения и войдите."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它会立即失去访问权限。如需再次使用，请从该应用重新连接并登录。"
          }
        }
      }
    },
