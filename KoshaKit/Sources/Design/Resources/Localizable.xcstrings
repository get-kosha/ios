    "tx_remove_refund_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die {amount} auf {account} werden gelöscht und zählen wieder als Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The {amount} back to {account} is deleted, and counts as spending again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran los {amount} devueltos a {account} y vuelven a contar como gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les {amount} remboursés sur {account} sont supprimés et comptent de nouveau comme dépense."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{account} में वापस आए {amount} हट जाएँगे, और यह रकम फिर से खर्च में गिनी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I {amount} restituiti su {account} vengono eliminati e tornano a contare come spesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{account}への{amount}の返金が削除され、その分は再び支出として数えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{account}(으)로 받은 {amount} 환불이 삭제되고, 그만큼 다시 지출로 계산돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De {amount} terug naar {account} wordt verwijderd en telt weer als uitgave."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os {amount} devolvidos para {account} são apagados e voltam a contar como despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат {amount} на {account} будет удалён, и эта сумма снова будет считаться расходом."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "退回到 {account} 的 {amount} 将被删除，并重新计入支出。"
          }
        }
      }
    },
