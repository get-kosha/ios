    "pwa_install_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Kosha über deinen Home-Bildschirm oder dein Dock, auch offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it from your home screen or dock, even offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo desde tu pantalla de inicio o el Dock, incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-la depuis votre écran d'accueil ou le Dock, même hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे होम स्क्रीन या डॉक से खोलें, ऑफ़लाइन भी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprila dalla schermata Home o dal Dock, anche offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面やDockから開けます。オフラインでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인에서도 홈 화면이나 Dock에서 바로 열 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open hem vanaf je beginscherm of dock, zelfs offline."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra pela tela inicial ou pelo Dock, mesmo offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте с главного экрана или из дока, даже без интернета."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从主屏幕或程序坞打开，离线也能用。"
          }
        }
      }
    },
    "pwa_install_ios": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Teilen“ und dann auf „Zum Home-Bildschirm“, um Kosha wie eine App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Share, then Add to Home Screen, to open Kosha like an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Compartir y luego Añadir a pantalla de inicio para abrir Kosha como una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Partager, puis Sur l'écran d'accueil, pour ouvrir Kosha comme une app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha को ऐप की तरह खोलने के लिए Share पर टैप करें, फिर Add to Home Screen चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Condividi, poi Aggiungi alla schermata Home, per aprire Kosha come un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有をタップし、「ホーム画面に追加」を選ぶと、Koshaをアプリのように開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유를 누른 다음 홈 화면에 추가를 누르면 Kosha를 앱처럼 열 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Deel en dan op Zet op beginscherm om Kosha als een app te openen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Compartilhar e depois em Adicionar à Tela de Início para abrir o Kosha como um app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Поделиться», затем «На экран „Домой“», чтобы открывать Kosha как приложение."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“分享”，再选择“添加到主屏幕”，就能像应用一样打开 Kosha。"
          }
        }
      }
    },
