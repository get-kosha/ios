    "settings_ai_masked_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Namen der Zahlungspartner“ aus, ersetzt Kosha jeden Namen durch einen festen Code. So kann das Modell sie weiter gruppieren, ohne zu wissen, wer sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Payee names off, Kosha swaps each name for a stable code, so the model can still group them without knowing who they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Nombres de beneficiarios desactivado, Kosha cambia cada nombre por un código fijo, para que el modelo pueda agruparlos sin saber quiénes son."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Noms des tiers désactivé, Kosha remplace chaque nom par un code stable : le modèle peut toujours les regrouper sans savoir de qui il s'agit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पार्टी के नाम बंद होने पर Kosha हर नाम की जगह एक स्थायी कोड रख देता है, ताकि मॉडल यह जाने बिना कि वे कौन हैं, उन्हें समूहों में बाँट सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Nomi dei beneficiari disattivato, Kosha sostituisce ogni nome con un codice fisso, così il modello può comunque raggrupparli senza sapere chi sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引先名がオフの場合、Koshaは各名前を固定のコードに置き換えます。そのため、モデルは相手が誰かを知らなくても、取引をグループ分けできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래처 이름을 끄면 Kosha가 각 이름을 고정 코드로 바꿔서, 모델은 누구인지 모른 채로 거래처를 묶을 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Namen van tegenpartijen uitstaat, vervangt Kosha elke naam door een vaste code, zodat het model ze nog steeds kan groeperen zonder te weten wie het zijn."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Nomes dos favorecidos desativado, o Kosha troca cada nome por um código fixo, para que o modelo ainda consiga agrupá-los sem saber quem são."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если «Названия контрагентов» выключены, Kosha заменяет каждое название постоянным кодом, так что модель может группировать операции, не зная, кто контрагент."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“交易对象名称”后，Kosha 会把每个名称替换为固定代码，模型仍能对它们归组，但不知道具体是谁。"
          }
        }
      }
    },
