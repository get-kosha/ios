    "app_signout_clears": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden wird gelöscht, was dieses Gerät gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out clears what this device saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión se borra lo que guardó este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion efface ce que cet appareil a enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट करने पर इस डिवाइस में सहेजी चीज़ें मिट जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscendo si cancella ciò che questo dispositivo ha salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトすると、このデバイスに保存された内容は消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하면 이 기기에 저장된 내용이 지워져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitloggen wist wat dit apparaat heeft bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair apaga o que este dispositivo salvou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выходе удаляется всё, что сохранено на этом устройстве."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录会清除此设备保存的内容。"
          }
        }
      }
    },
