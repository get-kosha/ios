    "settings_ai_log_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt jede KI-Anfrage und -Antwort 30 Tage lang auf, damit du prüfen kannst, was gesendet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps every AI request and response for 30 days, so you can check what was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva cada solicitud y respuesta de IA durante 30 días, para que puedas comprobar qué se envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve chaque requête et réponse d'IA pendant 30 jours, pour que vous puissiez vérifier ce qui a été envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर AI रिक्वेस्ट और जवाब को 30 दिनों तक रखता है, ताकि आप देख सकें कि क्या भेजा गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva ogni richiesta e risposta IA per 30 giorni, così puoi controllare cosa è stato inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAIリクエストとレスポンスを30日間保存し、何が送信されたかを確認できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AI 요청과 응답을 30일 동안 보관해서, 무엇이 전송됐는지 확인할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart elk AI-verzoek en -antwoord 30 dagen, zodat je kunt controleren wat er is verstuurd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda todas as solicitações e respostas de IA por 30 dias, para você conferir o que foi enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит каждый запрос к ИИ и ответ 30 дней, чтобы вы могли проверить, что было отправлено."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保留每次 AI 请求和响应 30 天，方便你检查发送了什么。"
          }
        }
      }
    },
    "settings_ai_log_dialog_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau das, was gesendet wurde und zurückkam, aus den letzten 30 Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly what was sent and what came back, for the last 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactamente lo que se envió y lo que volvió, en los últimos 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactement ce qui a été envoyé et ce qui est revenu, sur les 30 derniers jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 30 दिनों में ठीक-ठीक क्या भेजा गया और क्या वापस आया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esattamente cosa è stato inviato e cosa è tornato, negli ultimi 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去30日間に送信された内容と、返ってきた内容をそのまま表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 30일 동안 보낸 내용과 받은 내용 그대로예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precies wat er is verstuurd en wat er terugkwam, over de afgelopen 30 dagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente o que foi enviado e o que voltou, nos últimos 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что именно было отправлено и что пришло в ответ за последние 30 дней."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 30 天内发送和返回的确切内容。"
          }
        }
      }
