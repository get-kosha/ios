    "auth_consent_local_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube sie nur, wenn du sie gerade selbst gestartet hast, zum Beispiel in einem Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it only if you just started it, for example in a terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítela solo si acabas de iniciarla, por ejemplo en un terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez-la seulement si vous venez de la lancer, par exemple dans un terminal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे तभी अनुमति दें जब आपने इसे अभी-अभी शुरू किया हो, जैसे किसी टर्मिनल में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentila solo se l'hai appena avviata tu, per esempio in un terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルなどで自分で起動した直後の場合にのみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 등에서 방금 직접 실행한 경우에만 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta hem alleen toe als je hem net zelf hebt gestart, bijvoorbeeld in een terminal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita apenas se você acabou de iniciá-lo, por exemplo em um terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешайте, только если вы его только что запустили, например в терминале."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你刚刚启动它（例如在终端中）时才允许。"
          }
        }
      }
    },
