    "reconcile_drift": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zum {day} abgeglichenen Buchungen haben sich seitdem um {amount} geändert und passen nicht mehr zu diesem Kontoauszug. Eine wurde bearbeitet oder gelöscht. Mach diesen Abgleich rückgängig, um sie noch einmal zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries reconciled on {day} have changed by {amount} since, so they no longer add up to that statement. One was edited or deleted; undo that reconciliation to check them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos conciliados el {day} han cambiado en {amount} desde entonces, así que ya no cuadran con ese extracto. Se editó o eliminó alguno; deshaz esa conciliación para volver a comprobarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations rapprochées le {day} ont varié de {amount} depuis, elles ne correspondent donc plus à ce relevé. L'une a été modifiée ou supprimée ; annulez ce rapprochement pour les vérifier à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{day} को मिलान की गई एंट्रियाँ तब से {amount} बदल गई हैं, इसलिए अब वे उस स्टेटमेंट से मेल नहीं खातीं। किसी एंट्री को बदला या हटाया गया है; उन्हें फिर से जाँचने के लिए वह मिलान वापस लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I movimenti riconciliati il {day} sono cambiati di {amount} da allora, quindi non corrispondono più a quell'estratto conto. Uno è stato modificato o eliminato; annulla quella riconciliazione per ricontrollarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{day}に照合した取引がその後{amount}変わったため、その明細と一致しなくなりました。どれかが編集または削除されています。もう一度確認するには、その照合を取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{day}에 대조한 거래가 그 뒤로 {amount}만큼 바뀌어서 해당 명세서와 더 이상 맞지 않아요. 거래가 편집되거나 삭제됐어요. 다시 확인하려면 그 대조를 되돌리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties die op {day} zijn afgestemd, zijn sindsdien met {amount} veranderd, dus ze kloppen niet meer met dat afschrift. Er is er een bewerkt of verwijderd; maak die afstemming ongedaan om ze opnieuw te controleren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lançamentos conciliados em {day} mudaram {amount} desde então, e não batem mais com aquele extrato. Um deles foi editado ou excluído; desfaça essa conciliação para conferi-los de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, сверенные {day}, с тех пор изменились на {amount} и больше не сходятся с той выпиской. Одну из них изменили или удалили; отмените ту сверку, чтобы проверить их заново."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "{day} 对账的交易此后变化了 {amount}，与那份对账单已对不上。其中有交易被编辑或删除；撤销那次对账即可重新核对。"
          }
        }
      }
    },
