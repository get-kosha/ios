    "settings_sec_err_too_many": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warte kurz und versuch es dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a minute, then try again."
          }
        },
        "es": {
