    "settings_api_keys_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für deine eigenen Skripte und Kurzbefehle. Sende einen Schlüssel als Authorization: Bearer kosha_…. Wer einen Schlüssel hat, kann ihn nutzen, also halte ihn geheim."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your own scripts and shortcuts. Send a key as Authorization: Bearer kosha_…. Anyone with a key can use it, so keep it secret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tus propios scripts y atajos. Envía una clave como Authorization: Bearer kosha_…. Cualquiera que tenga una clave puede usarla, así que mantenla en secreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vos propres scripts et raccourcis. Envoyez une clé sous la forme Authorization: Bearer kosha_…. Toute personne qui a une clé peut l'utiliser : gardez-la secrète."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपनी स्क्रिप्ट और शॉर्टकट के लिए। कुंजी को Authorization: Bearer kosha_… के रूप में भेजें। जिसके पास भी कुंजी है वह इसे इस्तेमाल कर सकता है, इसलिए इसे गुप्त रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i tuoi script e comandi rapidi. Invia una chiave come Authorization: Bearer kosha_…. Chiunque abbia una chiave può usarla, quindi tienila segreta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自作のスクリプトやショートカット用です。キーは Authorization: Bearer kosha_… として送信してください。キーを持っていれば誰でも使えるため、秘密にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스크립트와 단축어용이에요. 키는 Authorization: Bearer kosha_… 형식으로 보내세요. 키가 있으면 누구나 쓸 수 있으니 비밀로 지키세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor je eigen scripts en snelkoppelingen. Stuur een sleutel mee als Authorization: Bearer kosha_…. Iedereen met een sleutel kan hem gebruiken, dus houd hem geheim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seus próprios scripts e atalhos. Envie a chave como Authorization: Bearer kosha_…. Qualquer pessoa com uma chave pode usá-la, então mantenha-a em segredo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ваших скриптов и быстрых команд. Передавайте ключ как Authorization: Bearer kosha_…. Им может воспользоваться любой, у кого он есть, поэтому храните его в секрете."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用于你自己的脚本和快捷指令。以 Authorization: Bearer kosha_… 的形式发送密钥。任何拿到密钥的人都能使用它，请妥善保密。"
          }
        }
      }
    },
