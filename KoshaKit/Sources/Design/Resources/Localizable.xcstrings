          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードの後に、認証アプリ（1Password、Authyなど）のコードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 입력 후 인증 앱(1Password, Authy 등)의 코드를 한 번 더 물어봐요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag na je wachtwoord om een code uit een authenticator-app (1Password, Authy…)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da senha, pede um código de um app autenticador (1Password, Authy…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пароля запрашивать код из приложения-аутентификатора (1Password, Authy…)."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "输入密码后，再要求输入身份验证器应用（1Password、Authy…）中的验证码。"
          }
        }
      }
    },
    "settings_sec_two_factor_on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An. Bei der Anmeldung mit Passwort fragt Kosha auch nach einem Code aus deiner Authenticator-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On. Signing in with your password also asks for a code from your authenticator app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activada. Al iniciar sesión con tu contraseña también se pide un código de tu app de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
