    "app_wel_import_later": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jetzt? Du kannst sie jederzeit über Konten oder Einstellungen › Import & Export importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
