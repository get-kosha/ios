    "settings_rules_learn_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Buchung speicherst, merkt sich Kosha die Kategorie des Zahlungspartners. Regeln, die du selbst anlegst, überschreibt Kosha nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you save a transaction, Kosha remembers its payee's category. Kosha never overwrites rules you make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando guardas un movimiento, Kosha recuerda la categoría de su beneficiario. Kosha nunca sobrescribe las reglas que creas tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous enregistrez une opération, Kosha retient la catégorie de son tiers. Kosha n'écrase jamais les règles que vous créez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप कोई लेन-देन सेव करते हैं, तो Kosha उसकी पार्टी की श्रेणी याद रखता है। आपके बनाए नियमों को Kosha कभी नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando salvi un movimento, Kosha ricorda la categoria del suo beneficiario. Kosha non sovrascrive mai le regole che crei tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を保存すると、Koshaはその取引先のカテゴリを覚えます。あなたが作ったルールが上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 저장하면 Kosha가 그 거래처의 카테고리를 기억해요. 직접 만든 규칙은 절대 덮어쓰지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een transactie opslaat, onthoudt Kosha de categorie van de tegenpartij. Kosha overschrijft nooit regels die je zelf maakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você salva uma transação, o Kosha memoriza a categoria do favorecido. O Kosha nunca substitui as regras que você cria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы сохраняете операцию, Kosha запоминает категорию её контрагента. Созданные вами правила Kosha никогда не перезаписывает."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保存交易时，Kosha 会记住其交易对象的分类。Kosha 绝不会覆盖你自己创建的规则。"
          }
        }
      }
    },
