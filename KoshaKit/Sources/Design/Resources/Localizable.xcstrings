    "settings_general_round_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt {rounded} statt {full} bei den großen Zahlen. Listen behalten die Cents."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show {rounded} instead of {full} on the big numbers. Lists keep cents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra {rounded} en lugar de {full} en las cifras grandes. Las listas mantienen los céntimos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher {rounded} au lieu de {full} sur les grands chiffres. Les listes gardent les centimes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़ी संख्याओं में {full} की जगह {rounded} दिखाएँ। सूचियों में पैसे (दशमलव) दिखते रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra {rounded} invece di {full} nei numeri grandi. Gli elenchi mantengono i centesimi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな数字を{full}ではなく{rounded}と表示します。リストでは小数部分も表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 숫자에서 {full} 대신 {rounded}(으)로 표시해요. 목록에는 소수점 아래가 그대로 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon {rounded} in plaats van {full} bij de grote getallen. Lijsten houden de centen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra {rounded} em vez de {full} nos números grandes. As listas mantêm os centavos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать {rounded} вместо {full} в крупных числах. В списках копейки остаются."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "大号数字显示为 {rounded}，而不是 {full}。列表中保留小数。"
          }
        }
      }
    },
    "settings_general_suggest_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen Zahlungspartner-Regeln und den früheren Buchungen des Zahlungspartners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your payee rules and the payee's past transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de tus reglas de beneficiarios y de los movimientos anteriores del beneficiario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'après vos règles de tiers et les opérations passées du tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पार्टी नियमों और उस पार्टी के पिछले लेन-देन से।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalle tue regole beneficiari e dai movimenti passati del beneficiario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引先ルールと、その取引先の過去の取引から提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래처 규칙과 해당 거래처의 지난 거래를 바탕으로 추천해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van je tegenpartijregels en eerdere transacties met de tegenpartij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nas suas regras de favorecidos e nas transações anteriores do favorecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашим правилам контрагентов и прошлым операциям контрагента."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的交易对象规则和该交易对象过去的交易。"
          }
        }
      }
    },
    "settings_general_time_zone_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monate und Tage richten sich nach dieser Zone, egal wo du gerade bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Months and days follow this zone, wherever you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los meses y los días siguen esta zona, estés donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mois et les jours suivent ce fuseau, où que vous soyez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कहीं भी हों, महीने और दिन इसी ज़ोन के हिसाब से चलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesi e giorni seguono questo fuso, ovunque tu sia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいても、月と日はこのタイムゾーンに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에 있든 월과 날짜는 이 시간대를 따라요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maanden en dagen volgen deze zone, waar je ook bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
