    "app_set_delete_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Exportiere vorher, wenn du unsicher bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These can't be undone. Export first if unsure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer. Exporta antes si no estás seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est irréversible. Exportez d'abord en cas de doute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें पलटा नहीं जा सकता। पक्का न हो तो पहले एक्सपोर्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Esporta prima se hai dubbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻せません。迷ったら先にエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없어요. 확실하지 않다면 먼저 내보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Exporteer eerst als je twijfelt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito. Exporte antes se não tiver certeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить. Если сомневаетесь, сначала сделайте экспорт."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些操作无法撤销。不确定的话请先导出。"
          }
        }
      }
    },
