    "settings_sec_disable_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung wird nur noch dein Passwort abgefragt. Deine Backup-Codes funktionieren nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in will only ask for your password. Your backup codes stop working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar sesión solo se pedirá tu contraseña. Tus códigos de respaldo dejarán de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ne demandera plus que votre mot de passe. Vos codes de secours cessent de fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करते समय सिर्फ़ आपका पासवर्ड माँगा जाएगा। आपके बैकअप कोड काम करना बंद कर देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per accedere ti verrà chiesta solo la password. I codici di backup smettono di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時にはパスワードだけが求められるようになります。バックアップコードは使えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 때 비밀번호만 물어봐요. 백업 코드는 더 이상 쓸 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het inloggen wordt dan alleen om je wachtwoord gevraagd. Je back-upcodes werken niet meer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao entrar, só será pedida sua senha. Seus códigos de backup param de funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе будет запрашиваться только пароль. Резервные коды перестанут работать."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时将只要求输入密码。你的备用码将失效。"
          }
        }
      }
