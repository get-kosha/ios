        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare किसी लोकल या प्राइवेट पते तक नहीं पहुँच सकता। ऐसा URL इस्तेमाल करें जिस तक वह पहुँच सके, जैसे Cloudflare Tunnel।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare non può raggiungere un indirizzo locale o privato. Usa un URL raggiungibile, come un Cloudflare Tunnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareからはローカルやプライベートのアドレスに接続できません。Cloudflare Tunnel など、接続できるURLを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 로컬 주소나 사설 주소에 접속할 수 없어요. Cloudflare Tunnel처럼 접속 가능한 URL을 사용해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare kan geen lokaal of privéadres bereiken. Gebruik een URL die het wel kan bereiken, zoals een Cloudflare Tunnel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare não consegue acessar um endereço local ou privado. Use uma URL que ela consiga acessar, como um Cloudflare Tunnel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare не может обратиться к локальному или частному адресу. Укажите доступный ему URL, например Cloudflare Tunnel."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 无法访问本地或私有地址。请使用它能访问的 URL，例如 Cloudflare Tunnel。"
          }
        }
      }
    },
