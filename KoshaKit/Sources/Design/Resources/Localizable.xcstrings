    "auth_2fa_no_access": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf deine Authenticator-App? Jeder gespeicherte Backup-Code funktioniert einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to your authenticator app? Each backup code you saved works once."
          }
        },
        "es": {
          "stringUnit": {
