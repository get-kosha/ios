    "settings_section_rules_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt ein Zahlungspartner zu einer Regel, setzt Kosha die Kategorie für dich. Eine Regel hat Vorrang vor allen anderen Vorschlägen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a payee matches a rule, Kosha fills in the category for you. A rule takes priority over any other suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un beneficiario coincide con una regla, Kosha rellena la categoría por ti. Una regla tiene prioridad sobre cualquier otra sugerencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un tiers correspond à une règle, Kosha remplit la catégorie pour vous. Une règle passe avant toute autre suggestion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई पार्टी किसी नियम से मेल खाती है, तो Kosha आपके लिए श्रेणी भर देता है। नियम किसी भी दूसरे सुझाव से ऊपर होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un beneficiario corrisponde a una regola, Kosha compila la categoria per te. Una regola ha la precedenza su qualsiasi altro suggerimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引先がルールに一致すると、Koshaがカテゴリを自動で入力します。ルールはほかのどの提案よりも優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래처가 규칙과 일치하면 Kosha가 카테고리를 채워 줘요. 규칙은 다른 어떤 추천보다 우선해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een tegenpartij overeenkomt met een regel, vult Kosha de categorie voor je in. Een regel gaat voor elke andere suggestie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um favorecido corresponde a uma regra, o Kosha preenche a categoria para você. Uma regra tem prioridade sobre qualquer outra sugestão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если контрагент подходит под правило, Kosha сама подставит категорию. Правило важнее любых других подсказок."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当交易对象符合某条规则时，Kosha 会为你填好分类。规则优先于其他任何建议。"
          }
        }
      }
    },
