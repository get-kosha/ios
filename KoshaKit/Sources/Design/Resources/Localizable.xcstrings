          "stringUnit": {
            "state": "translated",
            "value": "Its {count} transaction stays; it won't belong to an event any more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su {count} movimiento se conserva, pero ya no pertenecerá a ningún evento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son opération est conservée ; elle n'appartiendra plus à aucun événement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका {count} लेन-देन बना रहेगा; वह अब किसी इवेंट का हिस्सा नहीं रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo {count} movimento resta; non apparterrà più a un evento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De {count} transactie blijft bestaan, maar hoort dan niet meer bij een evenement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A {count} transação dele continua, mas não vai mais pertencer a um evento."
