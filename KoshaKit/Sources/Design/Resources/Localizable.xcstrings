    "settings_appearance_hide_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht Beträge unscharf, bis du darüberfährst. Diesen Schalter gibt es auch im Kontomenü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur money until you hover. The account menu has this switch too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difumina el dinero hasta que pasas el cursor. El menú de la cuenta también tiene este interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floute les montants jusqu'au survol. Le menu du compte propose aussi cet interrupteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माउस ले जाने तक रकम धुंधली रखें। अकाउंट मेन्यू में भी यह स्विच है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoca gli importi finché non ci passi sopra. Questo interruttore c'è anche nel menu dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを合わせるまで金額をぼかします。アカウントメニューにも同じスイッチがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스를 올리기 전까지 금액을 흐리게 해요. 계정 메뉴에도 이 스위치가 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedragen vervagen totdat je eroverheen beweegt. Deze schakelaar staat ook in het accountmenu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoca os valores até você passar o mouse. O menu da conta também tem essa opção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывать суммы, пока не наведёте курсор. Этот переключатель есть и в меню аккаунта."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊金额，悬停时显示。账号菜单中也有此开关。"
          }
        }
      }
    },
