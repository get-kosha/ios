            "value": "{file} से पढ़ी गई लाइनें उसके क्लोज़िंग बैलेंस से {amount} अलग हैं। उन्हें PDF से मिलाकर देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
