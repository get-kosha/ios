    "app_add_time_help_12": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh ein Rad oder tipp auf eine Zeile. 12-Stunden-Format, nach deiner Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flick or drag a wheel, or tap a row. 12-hour, from your language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira una rueda o toca una fila. Formato de 12 horas, según tu idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites tourner une roue ou touchez une ligne. Format 12 heures, selon votre langue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिया घुमाएँ या किसी पंक्ति पर टैप करें। आपकी भाषा के हिसाब से 12-घंटे का समय।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira una ruota o tocca una riga. Formato 12 ore, in base alla tua lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールを回すか、行をタップします。言語の設定に合わせて12時間表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠을 돌리거나 줄을 탭하세요. 언어에 맞춰 12시간제로 표시해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan een wiel of tik op een rij. 12-uursnotatie, volgens je taal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire uma roda ou toque em uma linha. Formato de 12 horas, conforme o seu idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите колесо или нажмите на строку. 12-часовой формат, по вашему языку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动滚轮或点按一行。按你的语言使用 12 小时制。"
          }
        }
      }
    },
