    "settings_events_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reise oder ein Anlass. Ordne Buchungen im Hinzufügen-Formular zu. Neue Buchungen, deren Datum hineinfällt, kommen automatisch dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip or an occasion. Add entries to it from the add form. New entries dated inside it join it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje o una ocasión. Añade movimientos desde el formulario de añadir. Los movimientos nuevos con fecha dentro del evento se unen a él automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voyage ou une occasion. Ajoutez-y des opérations depuis le formulaire d'ajout. Les nouvelles opérations datées pendant l'événement y sont rattachées automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ट्रिप या मौका। जोड़ने वाले फ़ॉर्म से इसमें एंट्रियाँ जोड़ें। इसकी तारीखों के अंदर वाली नई एंट्रियाँ अपने-आप इसमें जुड़ जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaggio o un'occasione. Aggiungi movimenti dal modulo di aggiunta. I nuovi movimenti con una data al suo interno vi entrano in automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行や行事のことです。追加フォームから取引を追加できます。期間内の日付の新しい取引は、自動でイベントに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행이나 행사예요. 추가 양식에서 거래를 이벤트에 넣을 수 있어요. 기간 안의 날짜로 추가한 새 거래는 자동으로 들어가요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een reis of een gelegenheid. Voeg er transacties aan toe via het toevoegformulier. Nieuwe transacties met een datum erbinnen horen er vanzelf bij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem ou ocasião. Adicione lançamentos a ela pelo formulário de adição. Novos lançamentos com data dentro dela entram automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка или повод. Добавляйте в событие операции из формы добавления. Новые операции с датой внутри события попадают в него автоматически."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一次旅行或一个特殊场合。可以在添加表单中把交易加入事件。日期在事件范围内的新交易会自动加入。"
          }
        }
      }
    },
