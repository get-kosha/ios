    "app_imp_offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Importieren brauchst du eine Verbindung. Wähl deine Dateien aus, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing needs a connection. Choose your files once you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para importar necesitas conexión. Elige tus archivos cuando vuelvas a estar en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation nécessite une connexion. Choisissez vos fichiers une fois de nouveau en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंपोर्ट के लिए कनेक्शन चाहिए। वापस ऑनलाइन होने पर फ़ाइलें चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per importare serve una connessione. Scegli i file quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みにはインターネット接続が必要です。オンラインに戻ってからファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오려면 인터넷 연결이 필요해요. 다시 온라인이 되면 파일을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren werkt alleen met een verbinding. Kies je bestanden zodra je weer online bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para importar, você precisa de conexão. Escolha seus arquivos quando estiver online de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для импорта нужно подключение. Выберите файлы, когда снова будете в сети."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "导入需要网络连接。恢复联网后再选择文件。"
          }
        }
      }
    },
