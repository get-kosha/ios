    "accounts_credit_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontostand ist das, was du noch ausgeben kannst. Beim Vermögen zählt die Differenz als Schulden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this account is what's left to spend. Net worth counts the difference as debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de esta cuenta es lo que te queda por gastar. El patrimonio neto cuenta la diferencia como deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de ce compte est ce qu'il reste à dépenser. Le patrimoine compte la différence comme une dette."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते का बैलेंस वह रकम है जो अभी खर्च की जा सकती है। नेट वर्थ बाकी अंतर को कर्ज़ के रूप में गिनती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo di questo conto è quanto ti resta da spendere. Il patrimonio netto conta la differenza come debito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座の残高は、あといくら使えるかを表します。限度額との差額は負債として純資産に計上されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계좌의 잔액은 남은 사용 가능 한도예요. 순자산에서는 한도와의 차이를 부채로 계산해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo van deze rekening is wat je nog kunt besteden. Je vermogen telt het verschil als schuld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo desta conta é o que ainda resta para gastar. O patrimônio conta a diferença como dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс этого счёта — это сумма, которую ещё можно потратить. В капитале разница учитывается как долг."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的余额是剩余可用的额度。净资产会把差额计为负债。"
          }
        }
      }
    },
