    "auth_error_offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ist nicht erreichbar. Prüf deine Verbindung und versuch es dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha couldn't be reached. Check your connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Kosha. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Kosha. Vérifiez votre connexion, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha तक पहुँच नहीं हो सकी। अपना कनेक्शन जाँचें, फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere Kosha. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaに接続できませんでした。接続状況を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha에 연결할 수 없어요. 인터넷 연결을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha is niet bereikbaar. Controleer je verbinding en probeer het dan opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao Kosha. Verifique sua conexão e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с Kosha. Проверьте подключение и попробуйте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Kosha。请检查网络连接后重试。"
          }
        }
      }
    },
