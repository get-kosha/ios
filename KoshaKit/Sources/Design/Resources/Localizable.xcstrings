    "settings_ai_enabled_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schalter für alles darunter. Aus heißt: Keine Anfrage verlässt Kosha."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One switch for everything below. Off means no request ever leaves Kosha."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor para todo lo de abajo. Desactivado significa que ninguna solicitud sale nunca de Kosha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul interrupteur pour tout ce qui suit. Désactivé, aucune requête ne quitte jamais Kosha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दी गई हर चीज़ के लिए एक स्विच। बंद होने पर कोई भी रिक्वेस्ट Kosha से बाहर नहीं जाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo interruttore per tutto ciò che c'è qui sotto. Se è disattivato, nessuna richiesta esce mai da Kosha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のすべてをまとめて切り替えるスイッチです。オフにすると、リクエストがKoshaの外に出ることは一切ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 모든 기능을 한 번에 켜고 끄는 스위치예요. 끄면 어떤 요청도 Kosha 밖으로 나가지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén schakelaar voor alles hieronder. Uit betekent dat er nooit een verzoek Kosha verlaat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um interruptor para tudo abaixo. Desativado significa que nenhuma solicitação sai do Kosha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один переключатель для всего, что ниже. Если выключено, ни один запрос не покидает Kosha."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下方所有功能的总开关。关闭后，不会有任何请求离开 Kosha。"
          }
        }
      }
    },
