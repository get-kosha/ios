    "settings_section_currencies_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Währungen, welche davon deine Hauptwährung ist und woher die Wechselkurse kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The currencies you hold, which one is your default, and where exchange rates come from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las monedas que tienes, cuál es la predeterminada y de dónde salen los tipos de cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les devises que vous détenez, celle par défaut et la source des taux de change."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास कौन-सी मुद्राएँ हैं, कौन-सी डिफ़ॉल्ट है, और एक्सचेंज रेट कहाँ से आते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valute che possiedi, quale è quella predefinita e da dove arrivano i tassi di cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保有している通貨、基本通貨、為替レートの取得元。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유한 통화, 기본 통화, 그리고 환율 출처."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De valuta's die je hebt, welke je standaard is, en waar de wisselkoersen vandaan komen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As moedas que você tem, qual delas é a padrão e de onde vêm as taxas de câmbio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши валюты, основная из них и источник курсов."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你持有的货币、默认货币，以及汇率的来源。"
          }
        }
      }
    },
