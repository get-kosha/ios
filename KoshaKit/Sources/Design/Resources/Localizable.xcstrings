    "auth_subline_create": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gehaltskonto in Berlin, Erspartes in Mumbai, eine Karte in Dollar, Bargeld in der Schublade. Kosha hält alles zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A salary account in Berlin, savings in Mumbai, a card in dollars, cash in the drawer. Kosha keeps them together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta nómina en Berlín, ahorros en Bombay, una tarjeta en dólares, efectivo en el cajón. Kosha lo reúne todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte salaire à Berlin, une épargne à Mumbai, une carte en dollars, des espèces dans le tiroir. Kosha les réunit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बर्लिन में सैलरी खाता, मुंबई में बचत, डॉलर में एक कार्ड, दराज़ में नकद। Kosha इन सबको साथ रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto stipendio a Berlino, i risparmi a Mumbai, una carta in dollari, i contanti nel cassetto. Kosha li tiene insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベルリンの給与口座、ムンバイの貯蓄、ドル建てのカード、引き出しの現金。Koshaがまとめて管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베를린의 급여 계좌, 뭄바이의 저축 계좌, 달러 카드, 서랍 속 현금. Kosha가 한데 모아 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een salarisrekening in Berlijn, spaargeld in Mumbai, een creditcard in dollars, contant geld in de la. Kosha houdt alles bij elkaar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta-salário em Berlim, a poupança em Mumbai, um cartão em dólares, dinheiro na gaveta. O Kosha mantém tudo junto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплатный счёт в Берлине, сбережения в Мумбаи, карта в долларах, наличные в ящике стола. Kosha собирает их вместе."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "柏林的工资账户、孟买的储蓄、美元信用卡、抽屉里的现金。Kosha 把它们放在一起。"
          }
        }
      }
    },
    "auth_subline_default": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankkonten, Bargeld, Karten und Geldanlagen, in jeder Währung, an einem Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank accounts, cash, cards and investments, in any currency, kept in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas bancarias, efectivo, tarjetas e inversiones, en cualquier moneda y en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes bancaires, espèces, cartes et placements, dans toutes les devises, réunis au même endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक खाते, नकद, कार्ड और निवेश, किसी भी मुद्रा में, सब एक जगह।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conti bancari, contanti, carte e investimenti, in qualsiasi valuta, tutti in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行口座、現金、カード、投資を、どんな通貨でもひとつの場所で管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 계좌, 현금, 카드, 투자까지, 어떤 통화든 한곳에서 관리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankrekeningen, contant geld, kaarten en beleggingen, in elke valuta, op één plek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas bancárias, dinheiro, cartões e investimentos, em qualquer moeda, reunidos em um só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банковские счета, наличные, карты и инвестиции в любой валюте — в одном месте."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "银行账户、现金、信用卡和投资，任意货币，统统放在一处。"
          }
        }
      }
    },
