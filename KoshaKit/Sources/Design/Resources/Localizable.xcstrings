    "auth_2fa_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warte ein paar Minuten und versuch es dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a few minutes, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera unos minutos y vuelve a intentarlo."
