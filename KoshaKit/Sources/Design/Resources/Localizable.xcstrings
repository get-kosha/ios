    "settings_danger_delete_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird alles in Kosha für {email} gelöscht. Es gibt keine Sicherung, und das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes everything in Kosha for {email}. There is no backup and it can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todo lo que hay en Kosha para {email}. No hay copia de seguridad y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tout ce que Kosha contient pour {email}. Il n'y a pas de sauvegarde et c'est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे {email} के लिए Kosha में मौजूद सब कुछ हट जाएगा। कोई बैकअप नहीं है और इसे वापस नहीं लिया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina tutto ciò che c'è in Kosha per {email}. Non esiste un backup e non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{email} のKoshaのデータをすべて削除します。バックアップはなく、元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{email}의 Kosha 데이터가 모두 삭제돼요. 백업이 없으며 되돌릴 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je alles in Kosha voor {email}. Er is geen back-up en het kan niet ongedaan worden gemaakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui tudo no Kosha de {email}. Não há backup, e não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалено всё, что есть в Kosha для {email}. Резервной копии нет, и это действие нельзя отменить."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除 {email} 在 Kosha 中的所有内容。没有备份，且无法撤销。"
          }
        }
      }
    },
