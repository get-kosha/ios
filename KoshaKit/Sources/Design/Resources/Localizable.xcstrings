        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That took too many look-ups. Try a narrower question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicieron falta demasiadas consultas. Prueba con una pregunta más concreta."
          }
