    "settings_section_api_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass KI-Assistenten und deine eigenen Skripte Kosha lesen und ändern. Du bestimmst, was jedes davon darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let AI assistants and your own scripts read and update Kosha. You choose what each one can do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que asistentes de IA y tus propios scripts lean y actualicen Kosha. Tú eliges qué puede hacer cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez des assistants IA et vos propres scripts lire et modifier Kosha. Vous choisissez ce que chacun peut faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI असिस्टेंट और अपनी स्क्रिप्ट को Kosha पढ़ने और अपडेट करने दें। हर एक क्या कर सकता है, यह आप तय करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti ad assistenti IA e ai tuoi script di leggere e aggiornare Kosha. Sei tu a scegliere cosa può fare ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスタントや自作のスクリプトからKoshaを読み書きできるようにします。それぞれに何を許可するかはあなたが選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 어시스턴트와 내 스크립트가 Kosha를 읽고 업데이트할 수 있게 해요. 각각 무엇을 할 수 있는지 직접 정해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat AI-assistenten en je eigen scripts Kosha lezen en bijwerken. Jij kiest wat elk ervan mag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que assistentes de IA e seus próprios scripts leiam e atualizem o Kosha. Você escolhe o que cada um pode fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвольте ИИ-ассистентам и вашим скриптам читать и обновлять данные в Kosha. Вы решаете, что может каждый из них."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 助手和你自己的脚本读取和更新 Kosha。每个能做什么由你决定。"
          }
        }
      }
    },
