    "settings_sec_save_codes_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dein Handy verlierst, kannst du dich mit jedem davon einmal anmelden. Kosha zeigt sie nicht noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose your phone, each of these lets you sign in once. Kosha won't show them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pierdes el móvil, cada uno te permite iniciar sesión una vez. Kosha no volverá a mostrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous perdez votre téléphone, chacun d'eux vous permet de vous connecter une fois. Kosha ne les affichera plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपका फ़ोन खो जाए, तो इनमें से हर कोड से एक बार साइन इन किया जा सकता है। Kosha इन्हें फिर नहीं दिखाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdi il telefono, ognuno di questi codici ti permette di accedere una volta. Kosha non li mostrerà più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホをなくしたときは、これらのコードでそれぞれ1回ログインできます。コードは二度と表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 잃어버리면 이 코드로 한 번씩 로그인할 수 있어요. Kosha는 이 코드를 다시 보여 주지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je telefoon kwijtraakt, kun je met elk van deze codes één keer inloggen. Kosha laat ze niet nog een keer zien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder o celular, cada um deles permite entrar uma vez. O Kosha não vai mostrá-los de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы потеряете телефон, каждый из этих кодов позволит войти один раз. Kosha больше их не покажет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果手机丢失，每个备用码可让你登录一次。Kosha 不会再次显示它们。"
          }
        }
      }
    },
