    "reconcile_pdf_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aus diesem PDF gelesenen Zeilen weichen um {amount} vom Saldo laut Kontoauszug ab. Vielleicht wurde eine Zeile falsch gelesen. Prüfe sie anhand des PDFs, bevor du etwas hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lines read from this PDF miss its closing balance by {amount}. A line may have been misread; check them against the PDF before adding any."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas leídas de este PDF no cuadran con su saldo final por {amount}. Puede que se leyera mal alguna línea; compáralas con el PDF antes de añadir ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes lues dans ce PDF s'écartent de {amount} de son solde final. Une ligne a peut-être été mal lue ; comparez-les avec le PDF avant d'en ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस PDF से पढ़ी गई लाइनें उसके क्लोज़िंग बैलेंस से {amount} अलग हैं। हो सकता है कोई लाइन गलत पढ़ी गई हो; कुछ भी जोड़ने से पहले उन्हें PDF से मिलाकर देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe lette da questo PDF si discostano dal suo saldo finale di {amount}. Una riga potrebbe essere stata letta male; confrontale con il PDF prima di aggiungerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPDFから読み取った行は、明細の締め残高と{amount}ずれています。読み取りを誤った行があるかもしれません。追加する前にPDFと照らし合わせて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PDF에서 읽은 거래가 명세서의 마감 잔액과 {amount} 차이 나요. 잘못 읽은 줄이 있을 수 있으니 추가하기 전에 PDF와 대조해 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regels uit deze pdf wijken {amount} af van het eindsaldo. Misschien is een regel verkeerd gelezen; vergelijk ze met de pdf voordat je iets toevoegt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas lidas deste PDF ficam {amount} distantes do saldo final dele. Uma linha pode ter sido lida errado; confira-as com o PDF antes de adicionar qualquer uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки, прочитанные из этого PDF, расходятся с конечным балансом на {amount}. Возможно, какая-то строка распознана неверно; сверьте их с PDF, прежде чем добавлять."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从此 PDF 读取的各行与其期末余额相差 {amount}。可能有一行识别有误；添加之前请对照 PDF 检查。"
          }
        }
      }
    },
