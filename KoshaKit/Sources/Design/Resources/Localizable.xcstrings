    "subs_end_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach heute gibt es keine Zahlungen mehr. Bisherige Zahlungen bleiben in Aktivität, und du kannst später fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No payments after today. Past payments stay in Activity, and you can resume it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá pagos a partir de hoy. Los pagos anteriores siguen en Actividad y puedes reanudarlo más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus aucun paiement après aujourd'hui. Les paiements passés restent dans Activité, et vous pourrez le reprendre plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के बाद कोई भुगतान नहीं होगा। पिछले भुगतान गतिविधि में बने रहेंगे, और आप इसे बाद में फिर से शुरू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pagamento dopo oggi. I pagamenti passati restano in Attività e puoi riattivarlo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日以降の支払いはなくなります。過去の支払いは履歴に残り、あとで再開することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 이후로는 결제가 없어요. 지난 결제는 내역에 남고, 나중에 다시 시작할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen betalingen meer na vandaag. Eerdere betalingen blijven in Activiteit staan en je kunt hem later hervatten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pagamento depois de hoje. Os pagamentos anteriores continuam em Atividade, e você pode retomar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сегодняшнего дня платежей не будет. Прошлые платежи останутся в разделе «Операции», а возобновить можно позже."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "今天之后不再付款。过去的付款仍保留在明细中，之后你也可以恢复。"
          }
        }
      }
    },
