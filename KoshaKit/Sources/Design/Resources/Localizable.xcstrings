    "auth_google_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Google hat nicht geklappt. Versuch es noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Google didn't work. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con Google. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Google n'a pas fonctionné. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google से साइन इन नहीं हो पाया। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso con Google non è riuscito. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleでログインできませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인에 실패했어요. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Google is niet gelukt. Probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entrar com o Google. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Google. Попробуйте ещё раз."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 登录失败，请重试。"
          }
        }
      }
    },
    "auth_google_not_linked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese E-Mail-Adresse gibt es schon ein Kosha-Konto. Melde dich mit deinem Passwort oder Passkey an und verbinde Google dann unter Einstellungen › Anmeldung & Sicherheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email already has a Kosha account. Sign in with your password or passkey, then connect Google in Settings › Sign-in & security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo ya tiene una cuenta de Kosha. Inicia sesión con tu contraseña o llave de acceso y luego conecta Google en Ajustes › Inicio de sesión y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail a déjà un compte Kosha. Connectez-vous avec votre mot de passe ou votre clé d'accès, puis associez Google dans Paramètres › Connexion et sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस ईमेल से पहले से एक Kosha अकाउंट है। अपने पासवर्ड या पासकी से साइन इन करें, फिर सेटिंग्स › साइन-इन और सुरक्षा में Google कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa email ha già un account Kosha. Accedi con la password o una passkey, poi collega Google in Impostazioni › Accesso e sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスにはすでにKoshaアカウントがあります。パスワードかパスキーでログインしてから、「設定 › ログインとセキュリティ」でGoogleを連携してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일로 이미 Kosha 계정이 있어요. 비밀번호나 패스키로 로그인한 다음 설정 › 로그인 및 보안에서 Google을 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een Kosha-account met dat e-mailadres. Log in met je wachtwoord of passkey en koppel daarna Google via Instellingen › Inloggen & beveiliging."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse e-mail já tem uma conta Kosha. Entre com sua senha ou chave de acesso e depois conecte o Google em Configurações › Login e segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого адреса уже есть аккаунт Kosha. Войдите с паролем или ключом доступа, затем подключите Google в разделе Настройки › Вход и безопасность."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该邮箱已有 Kosha 账号。请用密码或通行密钥登录，然后在“设置 › 登录与安全”中关联 Google。"
          }
        }
      }
    },
