    "auth_check_spam": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Minute noch nichts da? Schau im Spam-Ordner nach und schick sie dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing after a minute? Look in spam, then send it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No llega nada tras un minuto? Mira en spam y luego reenvíalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien au bout d'une minute ? Regardez dans les spams, puis renvoyez-le."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मिनट बाद भी कुछ नहीं आया? स्पैम में देखें, फिर दोबारा भेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non arriva niente dopo un minuto? Guarda nello spam, poi invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分たっても届かない場合は、迷惑メールフォルダを確認してから、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분이 지나도 오지 않나요? 스팸함을 확인한 뒤 다시 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een minuut nog niets? Kijk in je spam en stuur hem dan opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada depois de um minuto? Procure no spam e depois envie de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего нет через минуту? Загляните в спам, затем отправьте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一分钟后还没收到？请查看垃圾邮件，然后再发送一次。"
          }
        }
      }
    },
    "auth_check_step_choose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle {#b}{button}{/b}. Kosha öffnet sich dann in diesem oder einem anderen Browser."
          }
