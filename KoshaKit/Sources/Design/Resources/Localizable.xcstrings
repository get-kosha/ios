    "settings_rec_auto_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voreinstellung für neue wiederkehrende Zahlungen. Ist sie an, bucht Kosha feste Beträge am Fälligkeitstag. Jede Zahlung behält ihre eigene Einstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the default for new bills. When on, Kosha records fixed amounts on their due date. Each bill keeps its own choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define el valor predeterminado para las facturas nuevas. Si está activado, Kosha registra los importes fijos en su fecha de vencimiento. Cada factura conserva su propia opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la valeur par défaut des nouvelles factures. Si activé, Kosha enregistre les montants fixes à leur échéance. Chaque facture garde son propre choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए बिलों के लिए डिफ़ॉल्ट तय करता है। चालू होने पर Kosha तय रकम को देय तारीख पर दर्ज कर देता है। हर बिल की अपनी अलग सेटिंग रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il valore predefinito per le nuove bollette. Se attivo, Kosha registra gli importi fissi alla scadenza. Ogni bolletta mantiene la propria scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい請求の既定値を設定します。オンにすると、金額が決まっている支払いを期日にKoshaが記録します。請求ごとに個別の設定が保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 고정비의 기본값이에요. 켜면 Kosha가 정해진 금액을 예정일에 기록해요. 고정비마다 각자의 설정을 유지해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de standaard in voor nieuwe vaste lasten. Als dit aanstaat, legt Kosha vaste bedragen vast op de dag dat ze betaald moeten worden. Elke vaste last houdt zijn eigen keuze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o padrão para novas despesas fixas. Quando ativado, o Kosha registra valores fixos na data de vencimento. Cada despesa fixa mantém a própria escolha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение по умолчанию для новых обязательных платежей. Если включено, Kosha записывает фиксированные суммы в день оплаты. У каждого платежа остаётся своя настройка."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为新账单设置默认值。开启后，Kosha 会在到期日自动记录固定金额。每个账单可单独设置。"
          }
        }
      }
    },
    "settings_rec_auto_title": {
      "extractionState": "manual",
      "localizations": {
