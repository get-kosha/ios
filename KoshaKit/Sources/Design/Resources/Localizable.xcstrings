    "settings_ai_statements_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest PDF-Kontoauszüge und CSV-Dateien, die Kosha allein nicht versteht, erkennt Zahlungspartner im Banktext und hilft, eine Differenz beim Abgleich zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads PDF statements and CSV files Kosha can't work out alone, names payees from bank text, and helps find a reconciliation difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee extractos en PDF y archivos CSV que Kosha no puede interpretar por sí solo, pone nombre a los beneficiarios a partir del texto del banco y ayuda a encontrar una diferencia al conciliar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les relevés PDF et les fichiers CSV que Kosha ne sait pas interpréter seul, nomme les tiers à partir des libellés bancaires et aide à trouver un écart de rapprochement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे PDF स्टेटमेंट और CSV फ़ाइलें पढ़ता है जिन्हें Kosha अकेले नहीं समझ पाता, बैंक के टेक्स्ट से पार्टियों के नाम तय करता है, और मिलान में अंतर ढूँढने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge gli estratti conto in PDF e i file CSV che Kosha non riesce a interpretare da solo, ricava i beneficiari dal testo della banca e aiuta a trovare una differenza di riconciliazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaだけでは判別できないPDFの明細やCSVファイルを読み取り、銀行の摘要から取引先名を付け、照合の差額探しを手伝います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 명세서와 Kosha가 혼자 파악하지 못하는 CSV 파일을 읽고, 은행 문구로 거래처 이름을 정하고, 대조 차액을 찾도록 도와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest pdf-afschriften en CSV-bestanden die Kosha zelf niet kan ontcijferen, benoemt tegenpartijen op basis van banktekst en helpt een verschil bij het afstemmen te vinden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê extratos em PDF e arquivos CSV que o Kosha não consegue interpretar sozinho, nomeia favorecidos a partir do texto do banco e ajuda a encontrar uma diferença na conciliação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает выписки в PDF и файлы CSV, которые Kosha не может разобрать сама, превращает банковские описания в названия контрагентов и помогает найти разницу при сверке."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 PDF 对账单和 Kosha 无法自行识别的 CSV 文件，根据银行文本命名交易对象，并帮助查找对账差额。"
          }
        }
      }
    },
    "settings_ai_statements_sends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das PDF, das du importierst. Bei einer CSV nur die Spaltennamen. Banktext und Beträge nur, solange „Was die KI sieht“ sie freigibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF you import. For a CSV, only its column names. Bank text and amounts only while What AI can see shares them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PDF que importas. De un CSV, solo los nombres de sus columnas. El texto del banco y los importes, solo mientras Lo que ve la IA los comparta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PDF que vous importez. Pour un CSV, uniquement les noms de ses colonnes. Les libellés bancaires et les montants seulement si Ce que l'IA voit les partage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका इम्पोर्ट किया गया PDF। CSV के लिए सिर्फ़ उसके कॉलम के नाम। बैंक का टेक्स्ट और रकम सिर्फ़ तब, जब AI क्या देख सकता है में इन्हें शेयर करने की अनुमति हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il PDF che importi. Per un CSV, solo i nomi delle colonne. Testo della banca e importi solo se Cosa vede l'IA li condivide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートしたPDF。CSVの場合は列名だけ。銀行の摘要と金額は、「AIに見せる情報」で共有を許可している場合のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 PDF. CSV는 열 이름만. 은행 문구와 금액은 AI가 볼 수 있는 정보에서 공유할 때만."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pdf die je importeert. Bij een CSV alleen de kolomnamen. Banktekst en bedragen alleen als Wat AI kan zien ze deelt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PDF que você importa. Para um CSV, apenas os nomes das colunas. Texto do banco e valores apenas enquanto O que a IA pode ver os compartilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируемый PDF. Для CSV — только названия столбцов. Банковские описания и суммы — только если это разрешено в «Что видит ИИ»."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你导入的 PDF。对于 CSV，只发送其列名。仅当“AI 可见内容”允许共享时，才发送银行文本和金额。"
          }
        }
      }
    },
