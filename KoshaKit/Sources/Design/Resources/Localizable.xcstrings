          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{file}から読み取った行は、明細の締め残高と{amount}ずれています。PDFと照らし合わせて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{file}에서 읽은 거래가 명세서의 마감 잔액과 {amount} 차이 나요. PDF와 대조해 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regels uit {file} wijken {amount} af van het eindsaldo. Vergelijk ze met de pdf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas lidas de {file} ficam {amount} distantes do saldo final dele. Confira-as com o PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки, прочитанные из {file}, расходятся с конечным балансом выписки на {amount}. Сверьте их с PDF."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从 {file} 读取的各行与其期末余额相差 {amount}。请对照 PDF 检查。"
          }
        }
      }
