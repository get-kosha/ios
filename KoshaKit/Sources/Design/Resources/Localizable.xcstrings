    "auth_reset_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die E-Mail-Adresse ein, die du für Kosha nutzt. Wir schicken dir einen Link, mit dem du ein neues Passwort festlegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the email you use for Kosha. We'll send a link to set a new password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el correo que usas en Kosha. Te enviaremos un enlace para crear una nueva contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l'adresse e-mail que vous utilisez pour Kosha. Nous vous enverrons un lien pour définir un nouveau mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha के लिए आप जो ईमेल इस्तेमाल करते हैं, वह लिखें। हम नया पासवर्ड सेट करने के लिए एक लिंक भेजेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l'email che usi per Kosha. Ti invieremo un link per impostare una nuova password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaで使っているメールアドレスを入力してください。新しいパスワードを設定するためのリンクをお送りします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha에서 쓰는 이메일을 입력하세요. 새 비밀번호를 설정할 수 있는 링크를 보내 드려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het e-mailadres in dat je voor Kosha gebruikt. We sturen je een link om een nieuw wachtwoord in te stellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o e-mail que você usa no Kosha. Vamos enviar um link para criar uma nova senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес почты, который вы используете в Kosha. Мы пришлём ссылку для нового пароля."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你用于 Kosha 的邮箱。我们会发送一个链接，用于设置新密码。"
          }
        }
      }
    },
