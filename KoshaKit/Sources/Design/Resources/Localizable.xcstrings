          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa cuenta de Google tiene otro correo. Elige la que tenga tu correo de Kosha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Google a une autre adresse e-mail. Choisissez celui qui utilise votre adresse e-mail Kosha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस Google अकाउंट का ईमेल अलग है। वह अकाउंट चुनें जिसमें आपका Kosha ईमेल है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account Google ha un'email diversa. Scegli quello con l'email del tuo account Kosha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのGoogleアカウントはメールアドレスが異なります。Koshaのメールアドレスと同じアカウントを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Google 계정은 이메일이 달라요. Kosha 이메일과 같은 계정을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat Google-account heeft een ander e-mailadres. Kies het account met je Kosha-e-mailadres."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa conta Google tem outro e-mail. Escolha a que tem o seu e-mail do Kosha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого аккаунта Google другой адрес почты. Выберите тот, что совпадает с почтой в Kosha."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该 Google 账号的邮箱不同。请选择使用你 Kosha 邮箱的那个账号。"
          }
        }
      }
    },
    "settings_sec_google_not_fresh": {
