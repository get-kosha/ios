        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間、このブラウザではコードを求められません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그동안 이 브라우저에서는 코드를 묻지 않아요."
