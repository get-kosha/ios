    "app_set_hide_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht Beträge unscharf, bis du sie gedrückt hältst. Diesen Schalter gibt es auch im Kontomenü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur money until you touch and hold it. The account menu has this switch too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difumina el dinero hasta que lo mantienes pulsado. El menú de la cuenta también tiene este interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floute les montants jusqu'à un appui prolongé. Le menu du compte propose aussi cet interrupteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छूकर दबाए रखने तक रकम धुंधली रखें। अकाउंट मेन्यू में भी यह स्विच है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoca gli importi finché non li tieni premuti. Questo interruttore c'è anche nel menu dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しするまで金額をぼかします。アカウントメニューにも同じスイッチがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르기 전까지 금액을 흐리게 해요. 계정 메뉴에도 이 스위치가 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedragen vervagen totdat je ze ingedrukt houdt. Deze schakelaar staat ook in het accountmenu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoca os valores até você tocar e segurar. O menu da conta também tem essa opção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывать суммы, пока вы не нажмёте и не удержите их. Этот переключатель есть и в меню аккаунта."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊金额，长按时显示。账号菜单中也有此开关。"
          }
        }
      }
    },
