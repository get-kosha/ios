    "settings_danger_transactions_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Buchungen, Umbuchungen, Werte von Geldanlagen und wiederkehrende Zahlungen. Konten, Kategorien, Regeln und Einstellungen bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes transactions, transfers, investment values and recurring payments. Keeps your accounts, categories, rules and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina movimientos, transferencias, valores de inversiones y pagos recurrentes. Conserva tus cuentas, categorías, reglas y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les opérations, virements, valeurs de placements et paiements récurrents. Conserve vos comptes, catégories, règles et paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन, ट्रांसफ़र, निवेश की वैल्यू और नियमित भुगतान हट जाते हैं। आपके खाते, श्रेणियाँ, नियम और सेटिंग्स बने रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina movimenti, giroconti, valori degli investimenti e pagamenti ricorrenti. Mantiene conti, categorie, regole e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引、振替、投資の評価額、定期支払いを削除します。口座、カテゴリ、ルール、設定は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래, 이체, 투자 평가액, 정기 거래를 삭제해요. 계좌, 카테고리, 규칙, 설정은 남아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert transacties, overboekingen, beleggingswaarden en terugkerende betalingen. Je rekeningen, categorieën, regels en instellingen blijven bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui transações, transferências, valores de investimentos e pagamentos recorrentes. Mantém suas contas, categorias, regras e configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет операции, переводы, стоимость инвестиций и регулярные платежи. Счета, категории, правила и настройки сохраняются."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "删除交易、转账、投资市值和定期付款。保留你的账户、分类、规则和设置。"
          }
        }
      }
    },
    "settings_danger_type_email": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine E-Mail-Adresse ein, um zu bestätigen, dass du dieses Kosha-Konto meinst."
          }
