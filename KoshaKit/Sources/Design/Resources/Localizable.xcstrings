    "app_signin_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf {host} mit deinem Passwort, einem Passkey oder Google an oder erstelle ein Konto. Kosha bringt dich danach hierher zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in or create an account on {host} with your password, a passkey or Google. Kosha brings you back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión o crea una cuenta en {host} con tu contraseña, una llave de acceso o Google. Kosha te trae de vuelta aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous ou créez un compte sur {host} avec votre mot de passe, une clé d’accès ou Google. Kosha vous ramène ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} पर अपने पासवर्ड, पासकी या Google से साइन इन करें या खाता बनाएँ। Kosha आपको यहाँ वापस ले आएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi o crea un account su {host} con la tua password, una passkey o Google. Kosha ti riporta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} でパスワード、パスキー、または Google を使ってサインインするか、アカウントを作成します。完了すると Kosha に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}에서 비밀번호, 패스키 또는 Google로 로그인하거나 계정을 만드세요. 끝나면 Kosha로 돌아와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in of maak een account aan op {host} met je wachtwoord, een passkey of Google. Kosha brengt je daarna hier terug."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ou crie uma conta em {host} com sua senha, uma chave de acesso ou o Google. O Kosha traz você de volta para cá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите или создайте аккаунт на {host} с паролем, ключом доступа или через Google. Kosha вернёт вас сюда."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 {host} 用密码、通行密钥或 Google 登录或创建账户。完成后 Kosha 会带你回到这里。"
          }
        }
      }
    },
