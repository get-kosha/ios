    "settings_general_language_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Menüs, Meldungen und E-Mails. Dein Kosha-Konto merkt sich die Sprache, damit ein neuer Browser sie nach der Anmeldung übernimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, messages and emails. Your account remembers it, so a new browser follows it once you sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menús, mensajes y correos. Tu cuenta lo recuerda, así que un navegador nuevo lo usará en cuanto inicies sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, messages et e-mails. Votre compte la mémorise : un nouveau navigateur l'adopte dès que vous vous connectez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेन्यू, मैसेज और ईमेल। आपका अकाउंट इसे याद रखता है, इसलिए नए ब्राउज़र में साइन इन करते ही यही भाषा आ जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu, messaggi ed email. Il tuo account la ricorda, così un nuovo browser la usa appena accedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー、メッセージ、メール。アカウントに保存されるので、新しいブラウザでもログインすればこの言語になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴, 메시지, 이메일. 계정에 저장되므로 새 브라우저에서도 로그인하면 이 언어로 바뀌어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu's, meldingen en e-mails. Je account onthoudt het, dus een nieuwe browser volgt het zodra je inlogt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, mensagens e e-mails. Sua conta se lembra dele, então um novo navegador passa a usá-lo quando você entra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню, сообщения и письма. Аккаунт запоминает выбор, поэтому новый браузер подхватит его после входа."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单、消息和邮件。你的账号会记住它，登录新浏览器后也会沿用。"
          }
        }
      }
    },
