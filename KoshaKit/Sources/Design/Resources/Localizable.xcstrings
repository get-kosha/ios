    "settings_appearance_theme_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Hell- oder Dunkel-Einstellung deines Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows your device's light or dark setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue el ajuste claro u oscuro de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit le réglage clair ou sombre de votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम आपके डिवाइस की लाइट या डार्क सेटिंग के हिसाब से चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue l'impostazione chiara o scura del tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」を選ぶと、デバイスのライト・ダーク設定に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템을 고르면 기기의 라이트·다크 설정을 따라요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeem volgt de lichte of donkere instelling van je apparaat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue a configuração clara ou escura do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системная» следует светлому или тёмному режиму устройства."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随系统”会使用你设备的浅色或深色设置。"
          }
        }
      }
    },
    "settings_appearance_width_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Begrenzt“ hält Seiten bis 1240 px Breite mittig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxed keeps pages centred up to 1240px."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrado mantiene las páginas centradas hasta 1240 px."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encadrée garde les pages centrées jusqu'à 1240 px."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉक्स में पेज 1240px तक बीच में रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrata mantiene le pagine al centro fino a 1240px."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定幅では、ページを最大1240pxで中央に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 정렬은 페이지를 최대 1240px 너비로 가운데에 표시해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrensd houdt pagina's gecentreerd tot 1240px."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Centralizada mantém as páginas no centro, com até 1240px."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«В рамке» держит страницы по центру шириной до 1240 px."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "居中模式会将页面限制在 1240px 以内并居中。"
          }
        }
      }
    },
