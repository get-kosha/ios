        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많아요. 1분 정도 기다린 뒤 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Wacht een minuut en probeer het dan opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentativas demais. Aguarde um minuto e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Подождите минуту и попробуйте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请等一分钟后再试。"
          }
        }
      }
    },
