    "reconcile_drop_formats": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX oder QFX von deiner Bank. Kosha hakt ab, was übereinstimmt, und listet auf, was fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX or QFX from your bank. Kosha ticks what matches and lists what's missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX o QFX de tu banco. Kosha marca lo que coincide y enumera lo que falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX ou QFX de votre banque. Kosha coche ce qui correspond et liste ce qui manque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बैंक से CSV, OFX या QFX। Kosha मेल खाने वाली एंट्रियाँ टिक करता है और जो छूटा है उसकी सूची बनाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX o QFX dalla tua banca. Kosha spunta ciò che corrisponde ed elenca ciò che manca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行のCSV、OFX、QFXに対応。一致するものにKoshaがチェックを付け、足りないものを一覧にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 받은 CSV, OFX, QFX 파일. Kosha가 일치하는 거래를 체크하고 빠진 거래를 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX of QFX van je bank. Kosha vinkt af wat klopt en toont wat er ontbreekt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX ou QFX do seu banco. O Kosha marca o que confere e lista o que está faltando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV, OFX или QFX из вашего банка. Kosha отметит совпадения и покажет, чего не хватает."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "银行导出的 CSV、OFX 或 QFX 文件。Kosha 会勾选匹配的交易并列出缺少的交易。"
          }
        }
      }
    },
    "reconcile_drop_formats_pdf": {
