    "settings_sec_enable_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, dass du es bist. Danach scannst du einen QR-Code mit deiner Authenticator-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm it's you. Next you'll scan a QR code with your authenticator app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que eres tú. Después escanearás un código QR con tu app de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez votre identité. Vous scannerez ensuite un QR code avec votre application d'authentification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करें कि यह आप ही हैं। इसके बाद आप अपने ऑथेंटिकेटर ऐप से एक QR कोड स्कैन करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma che sei tu. Poi scansionerai un codice QR con la tua app di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認をしてください。次に、認証アプリでQRコードを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인인지 확인할게요. 다음 단계에서 인증 앱으로 QR 코드를 스캔해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat jij het bent. Daarna scan je een QR-code met je authenticator-app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que é você. Em seguida, você vai escanear um QR code com seu app autenticador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что это вы. Затем отсканируете QR-код приложением-аутентификатором."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认是你本人。接下来你需要用身份验证器应用扫描二维码。"
          }
        }
      }
    },
