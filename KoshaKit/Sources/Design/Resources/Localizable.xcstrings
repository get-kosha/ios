    "subs_edit_once_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Zahlung ändert sich. Alle anderen behalten den regulären Betrag und das Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this payment changes. Other payments keep the regular amount and date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia este pago. Los demás mantienen el importe y la fecha habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce paiement change. Les autres paiements gardent le montant et la date habituels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ यह भुगतान बदलेगा। बाकी भुगतानों की रकम और तारीख पहले जैसी रहेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo questo pagamento. Gli altri mantengono importo e data abituali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されるのは今回の支払いだけです。ほかの支払いは通常の金額と日付のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 결제만 바뀌어요. 다른 결제는 평소 금액과 날짜를 그대로 유지해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen deze betaling verandert. Andere betalingen houden het gewone bedrag en de gewone datum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este pagamento muda. Os outros mantêm o valor e a data de sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменится только этот платёж. Остальные сохранят обычную сумму и дату."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改这一笔付款。其他付款保持常规金额和日期。"
          }
        }
      }
    },
