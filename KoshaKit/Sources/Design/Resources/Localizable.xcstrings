    "reconcile_gap_opening": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} beginnt bei {opening}, aber {previous} endet bei {closing}. Vielleicht fehlt ein Kontoauszug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} opens at {opening}, but {previous} closes at {closing}. A statement may be missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} empieza en {opening}, pero {previous} cierra en {closing}. Puede que falte un extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} s'ouvre à {opening}, mais {previous} se termine à {closing}. Il manque peut-être un relevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} {opening} से शुरू होता है, लेकिन {previous} {closing} पर खत्म होता है। शायद कोई स्टेटमेंट छूट गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} si apre a {opening}, ma {previous} si chiude a {closing}. Potrebbe mancare un estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{next}の開始残高は{opening}ですが、{previous}の締め残高は{closing}です。明細が抜けている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{next}의 시작 잔액({opening})이 {previous}의 마감 잔액({closing})과 달라요. 명세서가 빠졌을 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} begint met {opening}, maar {previous} eindigt met {closing}. Er ontbreekt misschien een afschrift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} abre com {opening}, mas {previous} fecha com {closing}. Pode estar faltando um extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} начинается с баланса {opening}, а {previous} заканчивается на {closing}. Возможно, не хватает выписки."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "{next} 的期初余额为 {opening}，但 {previous} 的期末余额为 {closing}。可能缺少一份对账单。"
          }
        }
      }
    },
