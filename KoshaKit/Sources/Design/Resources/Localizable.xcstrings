    "welcome_sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüf diese drei Angaben und füg dann deine Konten hinzu. Das dauert nur ein, zwei Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check these three details, then add your accounts. It takes a minute or two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa estos tres datos y luego añade tus cuentas. Te llevará un par de minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ces trois informations, puis ajoutez vos comptes. Cela prend une minute ou deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये तीन बातें जाँच लें, फिर अपने खाते जोड़ें। इसमें बस एक-दो मिनट लगेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla questi tre dati, poi aggiungi i tuoi conti. Ci vuole un minuto o due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの項目を確認してから、口座を追加しましょう。1〜2分で終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 세 가지를 확인한 다음 계좌를 추가하세요. 1~2분이면 끝나요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer deze drie gegevens en voeg dan je rekeningen toe. Het kost een minuutje of twee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira estes três dados e depois adicione suas contas. Leva só um ou dois minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте эти три параметра, затем добавьте счета. Это займёт минуту-другую."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "确认这三项信息，然后添加你的账户。只需一两分钟。"
          }
        }
      }
    },
