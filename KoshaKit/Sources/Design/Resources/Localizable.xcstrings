    "reconcile_quick_balance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha zeigt heute {#amount}{amount}{/amount}. Vergleiche das mit dem aktuellen Kontostand deiner Bank, nicht mit dem verfügbaren Betrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha shows {#amount}{amount}{/amount} today. Compare it with your bank's current balance, not the available one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha muestra {#amount}{amount}{/amount} hoy. Compáralo con el saldo actual de tu banco, no con el disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha affiche {#amount}{amount}{/amount} aujourd'hui. Comparez avec le solde comptable de votre banque, pas le solde disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha आज {#amount}{amount}{/amount} दिखा रहा है। इसे अपने बैंक के मौजूदा बैलेंस से मिलाएँ, उपलब्ध बैलेंस से नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi Kosha mostra {#amount}{amount}{/amount}. Confrontalo con il saldo contabile della tua banca, non con quello disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のKoshaの残高は{#amount}{amount}{/amount}です。銀行の利用可能残高ではなく、現在の残高と比べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 Kosha에 표시된 잔액: {#amount}{amount}{/amount}. 은행의 사용 가능 잔액이 아니라 현재 잔액과 비교하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha toont vandaag {#amount}{amount}{/amount}. Vergelijk dat met het huidige saldo bij je bank, niet met het beschikbare saldo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha mostra {#amount}{amount}{/amount} hoje. Compare com o saldo atual do seu banco, não com o disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня Kosha показывает {#amount}{amount}{/amount}. Сравните с текущим балансом в банке, а не с доступным."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 显示今天的余额为 {#amount}{amount}{/amount}。请与银行的当前余额比较，而不是可用余额。"
          }
        }
      }
    },
    "reconcile_quick_owed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
