    "welcome_accounts_sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag ein, wie viel heute auf jedem ist. Entferne, was du nicht hast, und ergänze den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter what each one holds today. Remove any you don't have, and add the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce lo que tiene cada una hoy. Quita las que no tengas y añade el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ce que chacun contient aujourd'hui. Retirez ceux que vous n'avez pas et ajoutez les autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खाते में आज जितना है, वह लिखें। जो खाते आपके पास नहीं हैं उन्हें हटा दें, और बाकी जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci quanto contiene oggi ciascuno. Rimuovi quelli che non hai e aggiungi gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの今日の残高を入力してください。持っていないものは削除し、ほかの口座を追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 계좌에 지금 있는 금액을 입력하세요. 없는 계좌는 지우고, 나머지는 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul in wat er vandaag op elke rekening staat. Verwijder wat je niet hebt en voeg de rest toe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe quanto cada uma tem hoje. Remova as que você não tem e adicione as que faltam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите, сколько на каждом сегодня. Уберите те, которых у вас нет, и добавьте остальные."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "输入每个账户今天的金额。移除你没有的，再添加其余的。"
          }
        }
      }
    },
