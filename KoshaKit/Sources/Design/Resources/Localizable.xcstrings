    "settings_cat_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird nirgends verwendet, also ändert sich sonst nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing uses it, so nothing else changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada la usa, así que no cambia nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne l'utilise, donc rien d'autre ne change."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे कुछ भी इस्तेमाल नहीं करता, इसलिए और कुछ नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è usata da niente, quindi nient'altro cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用されていないため、ほかに変わるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하는 곳이 없어서 다른 데는 바뀌지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets gebruikt deze categorie, dus er verandert verder niets."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a usa, então nada mais muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она нигде не используется, поэтому больше ничего не изменится."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有内容使用它，因此不会影响其他内容。"
          }
        }
      }
    },
