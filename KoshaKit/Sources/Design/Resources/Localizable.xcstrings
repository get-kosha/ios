    "settings_sec_codes_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine alten Backup-Codes funktionieren nicht mehr, sobald du neue hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old backup codes stop working once you get new ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus códigos de respaldo antiguos dejan de funcionar cuando obtienes otros nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos anciens codes de secours cessent de fonctionner dès que vous en obtenez de nouveaux."
