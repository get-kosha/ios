        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple curiosité ? {#demo}Ouvrir la démo{/demo}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस देख रहे हैं? {#demo}डेमो खोलें{/demo}"
