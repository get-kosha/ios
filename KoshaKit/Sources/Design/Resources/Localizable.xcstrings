    "settings_general_default_account_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorausgewählt, wenn du etwas hinzufügst. „Zuletzt verwendet“ nimmt das Konto, das du auf diesem Gerät zuletzt genutzt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-selected when you add something. Last used picks the last account you used on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preseleccionada cuando añades algo. Última usada elige la última cuenta que usaste en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présélectionné quand vous ajoutez quelque chose. Dernier utilisé choisit le dernier compte utilisé sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ जोड़ते समय पहले से चुना रहता है। पिछला इस्तेमाल किया चुनने पर इस डिवाइस पर आखिरी बार इस्तेमाल किया गया खाता चुना जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preselezionato quando aggiungi qualcosa. Ultimo usato sceglie l'ultimo conto che hai usato su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するときに最初から選ばれる口座です。「前回使用」を選ぶと、このデバイスで最後に使った口座になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가를 추가할 때 미리 선택돼요. 마지막 사용을 고르면 이 기기에서 마지막으로 쓴 계좌가 선택돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooraf geselecteerd als je iets toevoegt. Laatst gebruikt kiest de rekening die je het laatst op dit apparaat hebt gebruikt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-selecionada quando você adiciona algo. Última usada escolhe a última conta que você usou neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирается заранее, когда вы что-то добавляете. «Последний» — это счёт, которым вы последним пользовались на этом устройстве."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "添加内容时预先选中。“上次使用”会选中你在这台设备上最后使用的账户。"
          }
        }
      }
    },
