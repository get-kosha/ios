    "subs_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts Wiederkehrendes. Trag Miete, ein Abo oder eine regelmäßige Umbuchung einmal ein, und Kosha behält sie im Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recurring yet. Add rent, a subscription or a regular transfer once and Kosha tracks it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada recurrente. Añade una vez el alquiler, una suscripción o una transferencia periódica y Kosha se encarga del seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de récurrent pour l'instant. Ajoutez une fois le loyer, un abonnement ou un virement régulier, et Kosha le suit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई नियमित भुगतान नहीं। किराया, कोई सब्सक्रिप्शन या नियमित ट्रांसफ़र एक बार जोड़ें, और Kosha उसका हिसाब रखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun pagamento ricorrente. Aggiungi una volta l'affitto, un abbonamento o un giroconto periodico e Kosha lo tiene d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期支払いはまだありません。家賃やサブスク、定期的な振替を一度追加すれば、あとはKoshaが記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 정기 거래가 없어요. 월세, 구독, 정기 이체를 한 번만 추가하면 Kosha가 계속 챙겨 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets terugkerends. Voeg één keer je huur, een abonnement of een vaste overboeking toe en Kosha houdt het bij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada recorrente ainda. Adicione o aluguel, uma assinatura ou uma transferência regular uma vez e o Kosha acompanha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярных платежей пока нет. Добавьте один раз аренду, подписку или регулярный перевод, и Kosha будет их отслеживать."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有定期付款。房租、订阅或定期转账只需添加一次，Kosha 就会持续跟踪。"
          }
        }
      }
    },
