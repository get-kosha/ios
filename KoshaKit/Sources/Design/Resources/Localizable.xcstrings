    "settings_currencies_reorder_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Der Währungsschalter oben geht sie in dieser Reihenfolge durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. The header's currency switch steps through them in this order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. El selector de moneda de la cabecera las recorre en este orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Le sélecteur de devise de l'en-tête les parcourt dans cet ordre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें। हेडर का मुद्रा स्विच इन्हें इसी क्रम में बदलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Il selettore di valuta in alto le scorre in questo ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えできます。ヘッダーの通貨切り替えは、この順番で切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸세요. 상단의 통화 전환 버튼은 이 순서대로 바뀌어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de volgorde te wijzigen. De valutaknop bovenaan doorloopt ze in deze volgorde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. O seletor de moeda no cabeçalho passa por elas nesta ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы изменить порядок. Переключатель валюты в шапке перебирает их в этом порядке."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整顺序。顶部的货币切换会按此顺序切换。"
          }
        }
      }
    },
