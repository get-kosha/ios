    "app_own_lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ist Open Source. Wenn du es selbst betreibst, gib die Adresse ein und melde dich dort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha is open source. If you run it yourself, enter its address and sign in there."
