    "import_account_dupes|any": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} Zeilen aus mehreren Kontoauszügen wurden nur einmal gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} lines in more than one statement counted once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} líneas que aparecen en más de un extracto se han contado una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} lignes présentes dans plusieurs relevés, comptées une seule fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक से ज़्यादा स्टेटमेंट में मौजूद {n} लाइनें एक ही बार गिनी गईं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} righe presenti in più estratti conto, contate una volta sola."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 명세서에 중복된 {n}줄은 한 번만 계산했어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} regels die in meer dan één afschrift stonden, zijn één keer geteld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} linhas presentes em mais de um extrato foram contadas uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} строки есть в нескольких выписках — учтены один раз."
          }
        },
