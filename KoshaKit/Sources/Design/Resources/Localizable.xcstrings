    "reconcile_hint_opening_gap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kontoauszug beginnt bei {opening}, aber der zuletzt abgeglichene endete bei {closing}. Vielleicht fehlt ein Kontoauszug dazwischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This statement opens at {opening}, but the last one you reconciled closed at {closing}. A statement in between may be missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este extracto empieza en {opening}, pero el último que conciliaste cerró en {closing}. Puede que falte un extracto entre medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce relevé s'ouvre à {opening}, mais le dernier que vous avez rapproché se terminait à {closing}. Il manque peut-être un relevé entre les deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्टेटमेंट {opening} से शुरू होता है, लेकिन जिस पिछले स्टेटमेंट का आपने मिलान किया था वह {closing} पर खत्म हुआ था। शायद बीच का कोई स्टेटमेंट छूट गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo estratto conto si apre a {opening}, ma l'ultimo che hai riconciliato si chiudeva a {closing}. Potrebbe mancare un estratto conto intermedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細の開始残高は{opening}ですが、前回照合した明細の締め残高は{closing}でした。間の明細が抜けている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명세서의 시작 잔액({opening})이 마지막으로 대조한 명세서의 마감 잔액({closing})과 달라요. 중간 명세서가 빠졌을 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit afschrift begint met {opening}, maar het laatste dat je hebt afgestemd eindigde met {closing}. Er ontbreekt misschien een afschrift daartussen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este extrato abre com {opening}, mas o último que você conciliou fechou com {closing}. Pode estar faltando um extrato entre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта выписка начинается с баланса {opening}, а последняя сверенная заканчивалась на {closing}. Возможно, не хватает выписки между ними."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此对账单的期初余额为 {opening}，但你上次对账的对账单期末余额为 {closing}。中间可能缺少一份对账单。"
          }
        }
      }
    },
