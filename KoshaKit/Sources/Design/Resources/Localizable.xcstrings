    "settings_sec_checklist_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In zwei Minuten erledigt. Jeder Schritt macht es schwerer, dein Kosha-Konto zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two minutes to finish. Each step makes your account harder to take over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos minutos para terminar. Cada paso hace que tu cuenta sea más difícil de robar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux minutes pour terminer. Chaque étape rend votre compte plus difficile à pirater."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा करने में दो मिनट लगेंगे। हर चरण आपके अकाउंट पर कब्ज़ा करना और मुश्किल बनाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due minuti per finire. Ogni passaggio rende il tuo account più difficile da violare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分で完了します。ステップを進めるごとに、アカウントが乗っ取られにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2분이면 끝나요. 단계를 하나씩 마칠수록 계정을 빼앗기기 어려워져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In twee minuten klaar. Elke stap maakt je account moeilijker over te nemen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois minutos para terminar. Cada etapa torna sua conta mais difícil de ser invadida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Займёт пару минут. Каждый шаг усложняет захват вашего аккаунта."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只需两分钟。每完成一步，你的账号就更难被盗用。"
          }
        }
      }
    },
