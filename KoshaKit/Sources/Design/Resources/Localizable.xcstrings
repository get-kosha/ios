        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No currency exchanges yet. Transfers between accounts in different currencies show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cambios de divisa. Aquí aparecen las transferencias entre cuentas en distintas monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun change pour l'instant. Les virements entre comptes de devises différentes s'affichent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई करेंसी एक्सचेंज नहीं है। अलग-अलग करेंसी वाले खातों के बीच ट्रांसफ़र यहाँ दिखते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun cambio valuta. Qui compaiono i trasferimenti tra conti in valute diverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両替はまだありません。通貨の異なる口座間の振替がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 환전이 없어요. 통화가 다른 계좌 간 이체가 여기에 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen valutawissels. Overboekingen tussen rekeningen in verschillende valuta staan hier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há câmbios. Transferências entre contas em moedas diferentes aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обменов валют пока нет. Здесь появятся переводы между счетами в разных валютах."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有货币兑换。不同币种账户之间的转账会显示在这里。"
          }
        }
      }
    },
