        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पासकी नहीं चली। फिर से कोशिश करें, या अपना पासवर्ड रीसेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey non ha funzionato. Riprova o reimposta la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーで認証できませんでした。もう一度試すか、パスワードを再設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키가 작동하지 않았어요. 다시 시도하거나 비밀번호를 재설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die passkey werkte niet. Probeer het opnieuw, of reset je wachtwoord."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa chave de acesso não funcionou. Tente de novo ou redefina sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ доступа не сработал. Попробуйте ещё раз или сбросьте пароль."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该通行密钥无效。请重试，或重置密码。"
          }
        }
      }
    },
