    "app_offline_none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst, was dieses Telefon gespeichert hat. Kosha aktualisiert es, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you see is what this phone saved. Kosha updates it when you’re back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ves es lo que guardó este teléfono. Kosha lo actualiza cuando vuelvas a tener conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez ce que ce téléphone a enregistré. Kosha le met à jour dès votre retour en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप वही देख रहे हैं जो इस फ़ोन ने सहेजा था। ऑनलाइन होते ही Kosha इसे अपडेट करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi ciò che questo telefono ha salvato. Kosha lo aggiorna quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されているのはこのスマートフォンに保存された内容です。オンラインに戻ると Kosha が更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보이는 건 이 휴대폰에 저장된 내용이에요. 다시 연결되면 Kosha가 업데이트해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet wat deze telefoon heeft bewaard. Kosha werkt het bij zodra je weer online bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você vê é o que este celular salvou. O Kosha atualiza quando você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видите то, что сохранено на телефоне. Kosha обновит это, когда появится сеть."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你看到的是此手机保存的内容。恢复联网后 Kosha 会更新。"
          }
        }
      }
    },
    "app_offline_waiting|any": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} Einträge sind auf diesem Telefon gespeichert. Kosha sendet sie, sobald du wieder online bist, und aktualisiert dann deine Summen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} entries are saved on this phone. Kosha sends them as soon as you’re back online, then updates your totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} movimientos están guardados en este teléfono. Kosha los envía en cuanto vuelvas a tener conexión y luego actualiza tus totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} opérations sont enregistrées sur ce téléphone. Kosha les envoie dès votre retour en ligne, puis met à jour vos totaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} एंट्रियाँ इस फ़ोन पर सहेजी गई हैं। ऑनलाइन होते ही Kosha उन्हें भेज देगा, फिर आपके कुल अपडेट करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} movimenti sono salvati su questo telefono. Kosha li invia appena torni online, poi aggiorna i totali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} 件の記録がこのスマートフォンに保存されています。オンラインに戻るとすぐに送信し、合計を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{count}개의 항목이 이 휴대폰에 저장되어 있어요. 다시 연결되면 Kosha가 바로 보내고 합계를 업데이트해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} boekingen staan op deze telefoon. Kosha verstuurt ze zodra je weer online bent en werkt dan je totalen bij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} lançamentos estão salvos neste celular. O Kosha os envia assim que você voltar a ficar online e depois atualiza seus totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} записи сохранено на телефоне. Kosha отправит их, как только появится сеть, и обновит итоги."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} 条记录已保存在此手机上。恢复联网后 Kosha 会立即发送并更新你的合计。"
          }
        }
      }
    },
