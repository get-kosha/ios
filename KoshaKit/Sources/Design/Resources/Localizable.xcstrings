      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Nettovermögen zählt, was du schuldest, als Schulden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net worth counts what you owe as debt."
