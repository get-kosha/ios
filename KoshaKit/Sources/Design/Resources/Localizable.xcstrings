    "ask_privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha sendet nur, was „{#link}Was die KI sieht{/link}“ erlaubt. Prüf wichtige Zahlen unter Aktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha sends only what {#link}What AI can see{/link} allows. Check important figures in Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha envía solo lo que permite {#link}Lo que ve la IA{/link}. Comprueba las cifras importantes en Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha n'envoie que ce que {#link}Ce que l'IA voit{/link} autorise. Vérifiez les chiffres importants dans Activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha सिर्फ़ वही भेजता है जिसकी {#link}AI क्या देख सकता है{/link} में अनुमति है। ज़रूरी आँकड़े गतिविधि में जाँच लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha invia solo ciò che {#link}Cosa vede l'IA{/link} consente. Verifica le cifre importanti in Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koshaが送信するのは{#link}AIに見せる情報{/link}で許可した内容だけです。重要な数字は履歴で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha는 {#link}AI가 볼 수 있는 정보{/link}에서 허용한 내용만 보내요. 중요한 수치는 내역에서 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha verstuurt alleen wat {#link}Wat AI kan zien{/link} toestaat. Controleer belangrijke bedragen in Activiteit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha envia só o que {#link}O que a IA pode ver{/link} permite. Confira os números importantes em Atividade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha отправляет только то, что разрешено в разделе {#link}Что видит ИИ{/link}. Важные цифры проверяйте в «Операциях»."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 只发送“{#link}AI 可见内容{/link}”允许的内容。重要数字请在明细中核实。"
          }
        }
      }
    },
