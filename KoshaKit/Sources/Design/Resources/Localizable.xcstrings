    "settings_appearance_motion_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagramme bauen sich auf, Zahlen rollen und Seiten gleiten. „Reduziert“ behält nur Überblendungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charts draw in, numbers roll and pages slide. Reduced keeps only fades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gráficos se dibujan, los números ruedan y las páginas se deslizan. Reducidas deja solo los fundidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graphiques se dessinent, les chiffres défilent et les pages glissent. Réduites ne garde que les fondus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ट बनते हुए दिखते हैं, संख्याएँ घूमती हैं और पेज खिसकते हैं। कम में सिर्फ़ फ़ेड रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I grafici si disegnano, i numeri scorrono e le pagine scivolano. Ridotte mantiene solo le dissolvenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフが描かれ、数字が回り、ページがスライドします。「控えめ」ではフェードだけになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트가 그려지고, 숫자가 굴러가고, 페이지가 미끄러지듯 바뀌어요. 줄이기를 고르면 페이드 효과만 남아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafieken tekenen zich op, getallen rollen en pagina's schuiven. Beperkt houdt alleen het vervagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gráficos se desenham, os números rolam e as páginas deslizam. Reduzidas mantém só os esmaecimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графики прорисовываются, числа прокручиваются, страницы сдвигаются. В уменьшенном режиме остаются только плавные появления."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "图表逐渐绘制、数字滚动、页面滑动。“减弱”只保留淡入淡出。"
          }
        }
      }
    },
