    "tx_event_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Buchungen in diesem Zeitraum landen automatisch in diesem Ereignis. Wiederkehrende Zahlungen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New entries between these dates go to this event on their own. Recurring payments don't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos nuevos entre estas fechas se añaden solos a este evento. Los pagos recurrentes no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles opérations entre ces dates sont rattachées automatiquement à cet événement. Les paiements récurrents ne le sont pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन तारीखों के बीच की नई एंट्रियाँ अपने-आप इस इवेंट में चली जाती हैं। नियमित भुगतान नहीं जाते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi movimenti tra queste date vanno in automatico in questo evento. I pagamenti ricorrenti no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間内の日付の新しい取引は、自動でこのイベントに追加されます。定期支払いは追加されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에 추가한 새 거래는 자동으로 이 이벤트에 들어가요. 정기 거래는 제외돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe transacties tussen deze datums horen vanzelf bij dit evenement. Terugkerende betalingen niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos lançamentos entre essas datas entram neste evento automaticamente. Pagamentos recorrentes, não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые операции между этими датами сами попадают в это событие. Регулярные платежи — нет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这段日期内的新交易会自动归入此事件。定期付款除外。"
          }
        }
      }
    },
