    "settings_section_data_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Kontoauszüge und lade all deine Daten herunter, wann immer du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import bank statements, and download all of your data whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa extractos bancarios y descarga todos tus datos cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des relevés bancaires et téléchargez toutes vos données quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंक स्टेटमेंट इम्पोर्ट करें, और जब चाहें अपना सारा डेटा डाउनलोड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa gli estratti conto e scarica tutti i tuoi dati quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行の明細をインポートしたり、すべてのデータをいつでもダウンロードしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 명세서를 가져오고, 언제든 모든 데이터를 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer bankafschriften en download al je gegevens wanneer je maar wilt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe extratos bancários e baixe todos os seus dados quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте банковские выписки и скачивайте все свои данные, когда захотите."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "导入银行对账单，并可随时下载你的全部数据。"
          }
        }
      }
    },
