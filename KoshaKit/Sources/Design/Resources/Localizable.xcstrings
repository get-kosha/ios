        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你收到此邮件，是因为有人为你的账号申请了密码重置。"
          }
        }
      }
    },
    "email_reset_not_you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Nicht von dir?{/strong} Ignorier diese E-Mail. Dein Passwort bleibt, wie es ist, und ohne diesen Link kann es niemand ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Didn't ask for this?{/strong} Ignore this email. Your password stays the same, and nobody can change it without this link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}¿No lo pediste?{/strong} Ignora este correo. Tu contraseña sigue igual y nadie puede cambiarla sin este enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Vous n'avez rien demandé ?{/strong} Ignorez cet e-mail. Votre mot de passe reste le même, et personne ne peut le changer sans ce lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}आपने यह अनुरोध नहीं किया?{/strong} इस ईमेल को अनदेखा करें। आपका पासवर्ड वही रहेगा, और इस लिंक के बिना कोई उसे बदल नहीं सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Non l'hai chiesto tu?{/strong} Ignora questa email. La tua password resta la stessa e nessuno può cambiarla senza questo link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}心当たりがない場合{/strong}は、このメールを無視してください。パスワードは変わらず、このリンクがなければ誰も変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}요청하지 않으셨나요?{/strong} 이 이메일은 무시하세요. 비밀번호는 그대로이며, 이 링크 없이는 아무도 바꿀 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Niet aangevraagd?{/strong} Negeer deze e-mail. Je wachtwoord blijft hetzelfde en niemand kan het wijzigen zonder deze link."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Não foi você que pediu?{/strong} Ignore este e-mail. Sua senha continua a mesma, e ninguém consegue alterá-la sem este link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}Не запрашивали?{/strong} Просто проигнорируйте это письмо. Ваш пароль останется прежним, и без этой ссылки никто не сможет его изменить."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}不是你申请的？{/strong}忽略此邮件即可。你的密码保持不变，没有这个链接，任何人都无法更改它。"
          }
        }
      }
    },
