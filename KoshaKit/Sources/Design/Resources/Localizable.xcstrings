    "auth_check_email_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es für {#strong}{email}{/strong} ein Kosha-Konto gibt, ist ein Link zum Zurücksetzen des Passworts unterwegs. Der Link funktioniert eine Stunde lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If {#strong}{email}{/strong} has a Kosha account, a link to reset its password is on its way. The link works for one hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si {#strong}{email}{/strong} tiene una cuenta de Kosha, un enlace para restablecer su contraseña va de camino. El enlace funciona durante una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si {#strong}{email}{/strong} a un compte Kosha, un lien pour réinitialiser son mot de passe est en route. Le lien est valable une heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर {#strong}{email}{/strong} का Kosha अकाउंट है, तो उसका पासवर्ड रीसेट करने का लिंक भेजा जा रहा है। लिंक एक घंटे तक काम करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se {#strong}{email}{/strong} ha un account Kosha, sta arrivando un link per reimpostarne la password. Il link funziona per un'ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}{email}{/strong} のKoshaアカウントが存在する場合、パスワード再設定用のリンクをお送りしました。リンクの有効期限は1時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{#strong}{email}{/strong}로 가입된 Kosha 계정이 있다면 비밀번호 재설정 링크를 보냈어요. 링크는 1시간 동안 유효해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als {#strong}{email}{/strong} een Kosha-account heeft, is er een link onderweg om het wachtwoord te resetten. De link werkt een uur lang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se {#strong}{email}{/strong} tiver uma conta Kosha, um link para redefinir a senha está a caminho. O link funciona por uma hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у {#strong}{email}{/strong} есть аккаунт Kosha, ссылка для сброса пароля уже в пути. Она действует один час."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 {#strong}{email}{/strong} 有 Kosha 账号，重置密码的链接已在发送途中。链接有效期为一小时。"
          }
        }
      }
    },
    "auth_check_email_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau in dein Postfach"
          }
