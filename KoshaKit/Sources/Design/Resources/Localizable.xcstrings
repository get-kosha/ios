    "settings_api_mcp_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt einem Assistenten dieselben Werkzeuge wie die API: suchen, hinzufügen, umkategorisieren, Auswertungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives an assistant the same tools the API has: search, add, recategorise, reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a un asistente las mismas herramientas que tiene la API: buscar, añadir, recategorizar e informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne à un assistant les mêmes outils que l'API : rechercher, ajouter, recatégoriser, rapports."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असिस्टेंट को वही टूल देता है जो API में हैं: खोजना, जोड़ना, श्रेणी बदलना, रिपोर्ट।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà a un assistente gli stessi strumenti dell'API: ricerca, aggiunta, ricategorizzazione, report."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIと同じツール（検索、追加、カテゴリの変更、レポート）をアシスタントに提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
