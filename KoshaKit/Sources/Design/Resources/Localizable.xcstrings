    "accounts_correct_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Kontostand deiner Bank ein, um ihn zu korrigieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the balance your bank shows to correct it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el saldo que muestra tu banco para corregirlo."
