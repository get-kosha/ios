    "auth_headline_create": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein ganzes Geld,\negal wo es liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your money,\nwherever it lives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo tu dinero,\nesté donde esté."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout votre argent,\noù qu'il se trouve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सारा पैसा,\nचाहे कहीं भी हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi soldi,\novunque si trovino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのお金を、\nどこにあっても\nひとつにまとめて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흩어진 내 돈,\n한곳에서."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je geld,\nwaar het ook staat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o seu dinheiro,\nonde quer que esteja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши деньги,\nгде бы они ни были."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有钱，\n无论放在哪里。"
          }
        }
      }
    },
    "auth_headline_default": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe notiert.\nMonat kapiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down what you spent.\nKnow where it went."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota lo que gastaste.\nSabrás dónde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez ce que vous dépensez.\nVoyez où c'est passé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो खर्च किया, लिख लीजिए।\nपैसा कहाँ गया, जान लीजिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ogni spesa.\nNessuna sorpresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サッと記録、\nちゃんと把握。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴 만큼 적고,\n간 곳은 알고."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave genoteerd.\nMaand gecontroleerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote o que gastou.\nSaiba onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потратили — записали.\nКуда ушло — узнали."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "花了就记，\n心里有底。"
          }
        }
      }
    },
