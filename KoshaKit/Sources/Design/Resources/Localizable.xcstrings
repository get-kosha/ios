    "app_set_ai_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Kosha funktioniert auch ohne vollständig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Kosha works fully without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Kosha funciona por completo sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Kosha fonctionne entièrement sans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। इसके बिना भी Kosha पूरी तरह चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativa. Kosha funziona del tutto anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。なくてもKoshaのすべての機能が使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 없어도 Kosha의 모든 기능을 쓸 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Kosha werkt ook volledig zonder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. O Kosha funciona por completo sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Kosha полностью работает и без этого."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。没有它 Kosha 也能完整使用。"
          }
        }
      }
    },
    "app_set_ai_key_stored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt auf dem Server gespeichert. Kosha zeigt ihn nie wieder an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored encrypted on the server. Kosha never shows it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda cifrada en el servidor. Kosha no vuelve a mostrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockée chiffrée sur le serveur. Kosha ne l'affiche plus jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर पर एन्क्रिप्ट करके रखी जाती है। Kosha इसे फिर कभी नहीं दिखाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata cifrata sul server. Kosha non la mostra mai più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに暗号化して保存されます。Koshaが再び表示することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 암호화해 저장돼요. Kosha는 다시 보여 주지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleuteld opgeslagen op de server. Kosha toont hem nooit meer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada criptografada no servidor. O Kosha nunca a mostra de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится на сервере в зашифрованном виде. Kosha больше его не покажет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在服务器上。Kosha 不会再显示它。"
          }
        }
      }
    },
    "app_set_ai_privacy_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Felder, die Kosha an deinen KI-Anbieter senden darf. Alles andere bleibt in Kosha."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fields Kosha may send to your AI provider. Everything else stays in Kosha."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos que Kosha puede enviar a tu proveedor de IA. Todo lo demás se queda en Kosha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs que Kosha peut envoyer à votre fournisseur d'IA. Tout le reste reste dans Kosha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे फ़ील्ड जिन्हें Kosha आपके AI प्रोवाइडर को भेज सकता है। बाकी सब Kosha में ही रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I campi che Kosha può inviare al tuo fornitore di IA. Tutto il resto resta in Kosha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KoshaがAIプロバイダに送れる項目です。それ以外はKoshaの外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 AI 제공업체에 보낼 수 있는 항목이에요. 나머지는 Kosha 안에 남아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velden die Kosha naar je AI-aanbieder mag sturen. Al het andere blijft in Kosha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos que o Kosha pode enviar ao seu provedor de IA. Todo o resto fica no Kosha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля, которые Kosha может отправлять вашему ИИ-провайдеру. Всё остальное остаётся в Kosha."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 可以发送给 AI 服务商的字段。其他内容都留在 Kosha 中。"
          }
        }
      }
    },
