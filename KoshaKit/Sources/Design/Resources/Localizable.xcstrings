    "settings_section_appearance_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Kosha in diesem Kosha-Konto aussieht. Änderungen gelten überall, wo du angemeldet bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Kosha looks on this account. Changes apply everywhere you sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se ve Kosha en esta cuenta. Los cambios se aplican en todos los lugares donde inicies sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apparence de Kosha pour ce compte. Les modifications s'appliquent partout où vous vous connectez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट पर Kosha कैसा दिखता है। बदलाव हर जगह लागू होते हैं जहाँ आप साइन इन करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspetto di Kosha su questo account. Le modifiche valgono ovunque accedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでのKoshaの見た目です。変更は、ログインしているすべての場所に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 Kosha가 보이는 방식. 변경 사항은 로그인한 모든 곳에 적용돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe Kosha eruitziet op dit account. Wijzigingen gelden overal waar je inlogt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência do Kosha nesta conta. As alterações valem em todo lugar onde você entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как Kosha выглядит в этом аккаунте. Изменения действуют везде, где вы входите."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 在此账号上的外观。修改会应用到你登录的所有地方。"
          }
        }
      }
