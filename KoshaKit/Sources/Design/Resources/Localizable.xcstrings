    "subs_delete_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird der Zeitplan entfernt. Bisherige Zahlungen bleiben als normale Buchungen in Aktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the schedule. Past payments stay in Activity as ordinary transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la programación. Los pagos anteriores siguen en Actividad como movimientos normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'échéancier. Les paiements passés restent dans Activité comme des opérations ordinaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे शेड्यूल हट जाएगा। पिछले भुगतान गतिविधि में सामान्य लेन-देन के रूप में बने रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianificazione viene rimossa. I pagamenti passati restano in Attività come movimenti normali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを削除します。過去の支払いは通常の取引として履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 삭제돼요. 지난 결제는 일반 거래로 내역에 남아 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je het schema. Eerdere betalingen blijven in Activiteit staan als gewone transacties."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a programação. Os pagamentos anteriores continuam em Atividade como transações comuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расписание будет удалено. Прошлые платежи останутся в разделе «Операции» как обычные операции."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除付款计划。过去的付款将作为普通交易保留在明细中。"
          }
        }
      }
    },
