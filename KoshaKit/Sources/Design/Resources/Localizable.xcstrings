    "settings_cat_merge_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha verschiebt {items} in die Kategorie, die du auswählst, und löscht danach {name}. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha moves its {items} to the category you pick, then deletes {name}. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha mueve sus {items} a la categoría que elijas y luego elimina {name}. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha déplace ses {items} vers la catégorie choisie, puis supprime {name}. C'est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha इसके {items} आपकी चुनी हुई श्रेणी में ले जाता है, फिर {name} को हटा देता है। इसे वापस नहीं लिया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha sposta {items} di questa categoria in quella che scegli, poi elimina {name}. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{items}を選んだカテゴリに移動してから、{name}を削除します。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 {items}을(를) 선택한 카테고리로 옮긴 다음 {name}을(를) 삭제해요. 되돌릴 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha verplaatst de {items} naar de categorie die je kiest en verwijdert daarna {name}. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha move {items} para a categoria que você escolher e depois exclui {name}. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha перенесёт в выбранную категорию всё, что к ней относится ({items}), а затем удалит категорию {name}. Это действие нельзя отменить."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 会把它的{items}移到你选择的分类，然后删除 {name}。此操作无法撤销。"
          }
        }
      }
    },
