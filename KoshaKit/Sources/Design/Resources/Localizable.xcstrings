    "auth_passkey_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey hat nicht funktioniert. Versuch es noch mal oder setz dein Passwort zurück."
