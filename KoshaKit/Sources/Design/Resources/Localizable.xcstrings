    "add_describe_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha füllt Betrag, Zahlungspartner, Kategorie, Konto und Datum aus. Du prüfst alles, bevor du es hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha fills in the amount, payee, category, account and date. You check it before adding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha rellena el importe, el beneficiario, la categoría, la cuenta y la fecha. Tú lo revisas antes de añadirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha remplit le montant, le tiers, la catégorie, le compte et la date. Vous vérifiez avant d'ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha रकम, पार्टी, श्रेणी, खाता और तारीख भर देता है। जोड़ने से पहले आप उसे जाँच लेते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha compila importo, beneficiario, categoria, conto e data. Tu controlli prima di aggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額、取引先、カテゴリ、口座、日付をKoshaが入力します。追加する前に確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha가 금액, 거래처, 카테고리, 계좌, 날짜를 채워 줘요. 추가하기 전에 확인하면 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha vult het bedrag, de tegenpartij, categorie, rekening en datum in. Jij controleert het voordat je het toevoegt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha preenche o valor, o favorecido, a categoria, a conta e a data. Você confere antes de adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha заполнит сумму, контрагента, категорию, счёт и дату. Вы проверите всё перед добавлением."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha 会自动填写金额、交易对象、分类、账户和日期。添加前由你确认。"
          }
        }
      }
    },
    "add_describe_label": {
