    "common_offline_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite ist auf diesem Gerät nicht gespeichert. Öffne sie wieder, sobald du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page wasn't saved on this device. Open it again once you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no se guardó en este dispositivo. Ábrela de nuevo cuando vuelvas a tener conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n'a pas été enregistrée sur cet appareil. Rouvrez-la une fois de retour en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेज इस डिवाइस पर सेव नहीं हुआ था। ऑनलाइन आने पर इसे फिर से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pagina non è stata salvata su questo dispositivo. Riaprila quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはこの端末に保存されていません。オンラインに戻ってから、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지는 이 기기에 저장되지 않았어요. 다시 온라인이 되면 열어 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze pagina is niet op dit apparaat opgeslagen. Open hem opnieuw zodra je weer online bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página não foi salva neste dispositivo. Abra-a de novo quando voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница не сохранена на устройстве. Откройте её снова, когда появится интернет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面未保存在这台设备上。恢复联网后再打开即可。"
          }
        }
      }
