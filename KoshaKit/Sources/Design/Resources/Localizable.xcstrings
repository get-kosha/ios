    "settings_danger_understand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist klar, dass meine Daten endgültig gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand my data will be permanently deleted."
