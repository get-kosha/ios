    "common_demo_read_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das Demokonto, deshalb sind Änderungen ausgeschaltet. Erstelle dein eigenes Konto, um Änderungen vorzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the demo account, so changes are turned off. Create your own account to make changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la cuenta demo, así que los cambios están desactivados. Crea tu propia cuenta para hacer cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est le compte de démo, les modifications sont donc désactivées. Créez votre propre compte pour faire des modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डेमो अकाउंट है, इसलिए इसमें बदलाव नहीं किए जा सकते। बदलाव करने के लिए अपना अकाउंट बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è l'account demo, quindi le modifiche sono disattivate. Crea un tuo account per poter modificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモアカウントのため、変更はできません。変更するには、ご自身のアカウントを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모 계정이라 변경할 수 없어요. 변경하려면 내 계정을 만들어 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het demo-account, dus wijzigingen staan uit. Maak je eigen account aan om dingen te wijzigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a conta demo, então as alterações estão desativadas. Crie sua própria conta para fazer alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это демо-аккаунт, поэтому изменения отключены. Создайте свой аккаунт, чтобы вносить изменения."
