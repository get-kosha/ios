    "auth_error_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, dich erneut anzumelden. Wenn du eine App verbinden wolltest, starte erneut in dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try signing in again. If you were connecting an app, start again from that app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta iniciar sesión de nuevo. Si estabas conectando una app, vuelve a empezar desde esa app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de vous connecter à nouveau. Si vous étiez en train de connecter une application, recommencez depuis cette application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से साइन इन करने की कोशिश करें। अगर आप कोई ऐप जोड़ रहे थे, तो उस ऐप से फिर से शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova ad accedere di nuovo. Se stavi collegando un’app, ricomincia da quell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度ログインしてください。アプリを接続していた場合は、そのアプリからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 로그인해 주세요. 앱을 연결하고 있었다면 해당 앱에서 다시 시작해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer je opnieuw aan te melden. Als je een app aan het koppelen was, begin dan opnieuw vanuit die app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente entrar novamente. Se você estava conectando um app, recomece por esse app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте войти ещё раз. Если вы подключали приложение, начните заново из этого приложения."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录。如果你正在连接某个应用，请从该应用重新开始。"
          }
        }
      }
    },
    "auth_error_email_taken": {
