    "settings_ai_receipts_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrag, Datum und Zahlungspartner aus einem Foto. Mach eins auf dem Handy beim Hinzufügen, oder füg es in die Schnelleingabe ein oder zieh es hinein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount, date and payee from a photo. Take one on the phone add screen, or paste or drop it into quick add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe, fecha y beneficiario a partir de una foto. Hazla en la pantalla de añadir del móvil, o pégala o suéltala en la entrada rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant, date et tiers à partir d'une photo. Prenez-en une sur l'écran d'ajout du téléphone, ou collez-la ou déposez-la dans la saisie rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो से रकम, तारीख और पार्टी। फ़ोन की जोड़ने वाली स्क्रीन पर फ़ोटो लें, या उसे झटपट जोड़ें में पेस्ट करें या छोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo, data e beneficiario da una foto. Scattala nella schermata di aggiunta sul telefono, oppure incollala o trascinala nell'aggiunta rapida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から金額、日付、取引先を読み取ります。スマホの追加画面で撮影するか、クイック入力に貼り付け・ドロップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에서 금액, 날짜, 거래처를 읽어요. 휴대폰 추가 화면에서 찍거나, 빠른 추가에 붙여 넣거나 끌어다 놓으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrag, datum en tegenpartij uit een foto. Maak er een op het toevoegscherm van je telefoon, of plak of sleep hem in snel toevoegen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor, data e favorecido a partir de uma foto. Tire uma na tela de adicionar do celular, ou cole ou solte na adição rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма, дата и контрагент по фото. Сделайте снимок на экране добавления на телефоне или вставьте либо перетащите его в быстрый ввод."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从照片中读取金额、日期和交易对象。在手机添加页面拍照，或粘贴、拖入快速添加。"
          }
        }
      }
    },
