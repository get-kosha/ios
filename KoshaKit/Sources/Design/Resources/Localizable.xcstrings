    "pwa_offline_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst die Daten deines letzten Besuchs. Neue Buchungen werden synchronisiert, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing data from your last visit. New entries sync when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando los datos de tu última visita. Los movimientos nuevos se sincronizan cuando vuelvas a tener conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de votre dernière visite. Les nouvelles opérations seront synchronisées dès votre retour en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पिछली विज़िट का डेटा दिख रहा है। नई एंट्रियाँ ऑनलाइन आते ही सिंक हो जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati della tua ultima visita. I nuovi movimenti si sincronizzano quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回表示したときのデータを表示しています。新しい取引はオンラインに戻ると同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 방문 때의 데이터를 보여 주고 있어요. 새 거래는 다시 온라인이 되면 동기화돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet gegevens van je vorige bezoek. Nieuwe transacties worden gesynchroniseerd zodra je weer online bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os dados da sua última visita. Novos lançamentos são sincronizados quando você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны данные с прошлого визита. Новые операции синхронизируются, когда появится интернет."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示你上次访问时的数据。新交易将在恢复联网后同步。"
          }
        }
      }
    },
