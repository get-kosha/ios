        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू। पासवर्ड से साइन इन करते समय आपके ऑथेंटिकेटर ऐप का कोड भी माँगा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
