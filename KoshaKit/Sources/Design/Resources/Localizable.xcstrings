    "settings_sec_scan_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dann den 6-stelligen Code ein, den sie anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then type the 6-digit code it shows to finish."
