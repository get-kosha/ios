    "settings_appearance_density_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt zeigt mehr Zeilen auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact fits more rows on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta muestra más filas en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact affiche plus de lignes à l'écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉम्पैक्ट में स्क्रीन पर ज़्यादा लाइनें आती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatta mostra più righe sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトにすると、画面に表示できる行が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촘촘하게를 고르면 화면에 더 많은 행이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact past meer regels op het scherm."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta mostra mais linhas na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В компактном режиме на экран помещается больше строк."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑模式可在屏幕上显示更多行。"
          }
        }
      }
    },
    "settings_appearance_figures_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit gleich breiten Ziffern stehen Beträge sauber in Spalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monospace lines amounts up in columns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monoespaciada alinea los importes en columnas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chasse fixe aligne les montants en colonnes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोनोस्पेस में रकम कॉलम में एक सीध में रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monospaziato allinea gli importi in colonna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等幅にすると、金額の桁が列でそろいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정폭을 고르면 금액이 열에 맞춰 정렬돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste breedte zet bedragen netjes onder elkaar in kolommen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monoespaçada alinha os valores em colunas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С моноширинными цифрами суммы выстраиваются в столбцы."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "等宽数字让金额在列中对齐。"
          }
        }
      }
