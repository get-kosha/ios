    "accounts_delete_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat keine Buchungen. Beim Löschen wird auch der Verlauf der Wertentwicklung gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no transactions. Deleting it also deletes its gains history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene movimientos. Al eliminarla también se elimina su historial de rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'a aucune opération. Le supprimer supprime aussi son historique de plus-values."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते में कोई लेन-देन नहीं है। इसे हटाने से इसकी रिटर्न हिस्ट्री भी हट जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto non ha movimenti. Eliminandolo elimini anche lo storico dei rendimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座には取引がありません。削除すると評価損益の履歴も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계좌에는 거래가 없어요. 삭제하면 손익 기록도 함께 삭제돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze rekening heeft geen transacties. Als je hem verwijdert, verdwijnt ook de rendementsgeschiedenis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem transações. Ao excluí-la, o histórico de rendimento também é excluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом счёте нет операций. Вместе с ним удалится и история прироста."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户没有交易。删除后，它的收益记录也会一并删除。"
          }
        }
      }
    },
