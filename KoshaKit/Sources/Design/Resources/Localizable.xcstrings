    "import_review_nothing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aus diesen Kontoauszügen ist schon in Kosha, es gibt also nichts hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in these statements is already in Kosha, so there's nothing to add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de estos extractos ya está en Kosha, así que no hay nada que añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de ces relevés est déjà dans Kosha : il n'y a rien à ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन स्टेटमेंट में सब कुछ पहले से Kosha में है, इसलिए जोड़ने के लिए कुछ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che c'è in questi estratti conto è già in Kosha, quindi non c'è niente da aggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの明細の内容はすべてKoshaに登録済みのため、追加するものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명세서의 거래는 모두 이미 Kosha에 있어서 추가할 게 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles uit deze afschriften staat al in Kosha, dus er valt niets toe te voegen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo nesses extratos já está no Kosha, então não há nada a adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё из этих выписок уже есть в Kosha, добавлять нечего."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些对账单中的内容都已在 Kosha 中，没有需要添加的。"
          }
        }
      }
    },
