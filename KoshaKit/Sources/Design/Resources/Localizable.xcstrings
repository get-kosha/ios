    "subs_variable_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha erinnert dich, wenn sie fällig ist, und fragt nach dem Betrag, statt sie automatisch zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha reminds you when it's due and asks for the amount, instead of recording it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha te avisa cuando vence y te pide el importe, en lugar de registrarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha vous prévient à l'échéance et vous demande le montant, au lieu de l'enregistrer automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने-आप दर्ज करने के बजाय, देय होने पर Kosha आपको याद दिलाता है और रकम पूछता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha ti avvisa quando è da pagare e ti chiede l'importo, invece di registrarlo in automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動で記録する代わりに、期日になるとKoshaがお知らせして金額を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 기록하는 대신, 예정일이 되면 Kosha가 알려 주고 금액을 물어봐요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha herinnert je eraan wanneer hij betaald moet worden en vraagt om het bedrag, in plaats van hem automatisch vast te leggen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha avisa quando vencer e pergunta o valor, em vez de registrar automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosha напомнит, когда подойдёт срок, и спросит сумму, вместо того чтобы записывать платёж автоматически."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "到期时 Kosha 会提醒你并询问金额，而不是自动记账。"
          }
        }
      }
    },
