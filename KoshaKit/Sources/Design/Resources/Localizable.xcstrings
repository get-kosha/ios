    "welcome_tz_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage und Monate richten sich danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days and months follow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días y los meses la siguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours et les mois le suivent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन और महीने इसी के हिसाब से चलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni e mesi lo seguono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日と月はこのタイムゾーンに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜와 월은 이 시간대를 따라요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen en maanden volgen deze zone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias e os meses seguem esse fuso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни и месяцы считаются по нему."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "日期和月份以它为准。"
          }
        }
      }
    },
