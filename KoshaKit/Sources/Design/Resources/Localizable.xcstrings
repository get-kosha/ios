    "subs_adopt_description|any": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus {count} pagos anteriores se archivan aquí, así que aparecen en su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses {count} paiements passés y sont rattachés et apparaissent donc dans son historique."
