        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot die tijd vraagt Kosha in deze browser niet om een code."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kosha não vai pedir um código neste navegador até lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До тех пор Kosha не будет спрашивать код в этом браузере."
