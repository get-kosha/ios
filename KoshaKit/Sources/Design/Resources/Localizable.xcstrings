    "auth_reset_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. Warte eine Minute und versuch es dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Wait a minute, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes. Espera un minuto y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes. Patientez une minute, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा अनुरोध हो गए। एक मिनट रुकें, फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste. Aspetta un minuto e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。1分ほど待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많아요. 1분 정도 기다린 뒤 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. Wacht een minuut en probeer het dan opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações demais. Aguarde um minuto e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Подождите минуту и попробуйте снова."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请求次数过多。请等一分钟后再试。"
          }
        }
      }
    },
    "auth_reset_signs_out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wirst du auf deinen anderen Geräten von Kosha abgemeldet. Passkeys und Zwei-Faktor bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving signs Kosha out on your other devices. Passkeys and two-factor stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se cerrará la sesión de Kosha en tus otros dispositivos. Las llaves de acceso y la verificación en dos pasos se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement déconnecte Kosha sur vos autres appareils. Les clés d'accès et la double authentification restent inchangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करने पर Kosha आपके दूसरे डिवाइस से साइन आउट हो जाएगा। पासकी और टू-फ़ैक्टर जैसे हैं वैसे ही रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando, Kosha esce dagli altri tuoi dispositivi. Passkey e autenticazione a due fattori restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、ほかのデバイスではKoshaからログアウトされます。パスキーと2段階認証はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 다른 기기에서는 Kosha에서 로그아웃돼요. 패스키와 2단계 인증은 그대로 유지돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het opslaan word je op je andere apparaten uitgelogd uit Kosha. Passkeys en tweestapsverificatie blijven zoals ze zijn."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, o Kosha sai da sua conta nos outros dispositivos. As chaves de acesso e os dois fatores continuam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сохранения Kosha выйдет из аккаунта на других ваших устройствах. Ключи доступа и двухфакторная аутентификация останутся как есть."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后，Kosha 会在你的其他设备上退出登录。通行密钥和双重验证保持不变。"
          }
        }
      }
    },
