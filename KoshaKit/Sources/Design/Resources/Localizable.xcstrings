    "import_review_sub_transfers|any|any|any": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} Buchungen: {p} Zahlungspartner und {t} Umbuchungen zwischen deinen Konten. Eine Änderung an einem Zahlungspartner gilt für alle seine Buchungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} transactions: {p} payees and {t} transfers between your accounts. A change to a payee applies to all of its transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} movimientos: {p} beneficiarios y {t} transferencias entre tus cuentas. Un cambio en un beneficiario se aplica a todos sus movimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} opérations : {p} tiers et {t} virements entre vos comptes. Une modification d'un tiers s'applique à toutes ses opérations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} लेन-देन: {p} पार्टियाँ और आपके खातों के बीच {t} ट्रांसफ़र। किसी पार्टी में किया गया बदलाव उसके सभी लेन-देन पर लागू होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} movimenti: {p} beneficiari e {t} giroconti tra i tuoi conti. Una modifica a un beneficiario vale per tutti i suoi movimenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 {n}건: 거래처 {p}곳, 내 계좌 간 이체 {t}건. 거래처를 바꾸면 그 거래처의 모든 거래에 적용돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} transacties: {p} tegenpartijen en {t} overboekingen tussen je rekeningen. Een wijziging aan een tegenpartij geldt voor al haar transacties."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} transações: {p} favorecidos e {t} transferências entre suas contas. Uma alteração em um favorecido vale para todas as transações dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операций: {n}, контрагентов: {p}, переводов между вашими счетами: {t}. Изменение контрагента применяется ко всем его операциям."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} 笔交易，涉及 {p} 个交易对象，以及 {t} 笔你的账户之间的转账。修改某个交易对象会应用到它的所有交易。"
          }
        }
      }
    },
