    "app_set_export_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads öffnen das Teilen-Menü, damit du sie in Dateien speichern oder weiterschicken kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads open the share sheet, so you can save them to Files or send them on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas abren el menú de compartir, para guardarlas en Archivos o enviarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements ouvrent le menu de partage, pour les enregistrer dans Fichiers ou les envoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड करने पर शेयर शीट खुलती है, ताकि आप उन्हें फ़ाइलों में सेव कर सकें या आगे भेज सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download aprono il menu di condivisione, così puoi salvarli in File o inviarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードすると共有シートが開くので、ファイルに保存したり送ったりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하면 공유 시트가 열려서 파일에 저장하거나 보낼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads openen het deelmenu, zodat je ze in Bestanden kunt bewaren of doorsturen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads abrem o menu de compartilhar, para salvar em Arquivos ou enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки открывают меню «Поделиться», чтобы сохранить файл в «Файлы» или отправить его."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下载会打开分享菜单，你可以保存到“文件”或发送出去。"
          }
        }
      }
    },
