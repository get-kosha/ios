    "overview_start_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh alle Kontoauszüge hierher, die du hast, von jeder Bank und Karte, so viele Monate du willst. Kosha legt die Konten an, importiert die Buchungen und ordnet sie nach Zahlungspartner. Du prüfst das Ergebnis, bevor etwas gespeichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop every statement you have, from each bank and card, as many months as you like. Kosha sets up the accounts, imports the transactions and sorts them by payee, and you check the result before anything is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta todos los extractos que tengas, de cada banco y tarjeta, de tantos meses como quieras. Kosha crea las cuentas, importa los movimientos y los ordena por beneficiario, y tú revisas el resultado antes de guardar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez tous vos relevés, de chaque banque et carte, sur autant de mois que vous voulez. Kosha crée les comptes, importe les opérations et les classe par tiers, et vous vérifiez le résultat avant que quoi que ce soit ne soit enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बैंक और कार्ड के अपने सारे स्टेटमेंट यहाँ छोड़ें, जितने महीनों के चाहें। Kosha खाते सेट अप करता है, लेन-देन इम्पोर्ट करता है और उन्हें पार्टी के हिसाब से छाँटता है। कुछ भी सेव होने से पहले आप नतीजा जाँच लेते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina tutti gli estratti conto che hai, di ogni banca e carta, per tutti i mesi che vuoi. Kosha crea i conti, importa i movimenti e li ordina per beneficiario, e tu controlli il risultato prima che venga salvato qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各銀行やカードの明細を、何か月分でもまとめてドロップしてください。Koshaが口座を作成し、取引をインポートして取引先ごとに整理します。保存する前に結果を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가진 명세서를 모든 은행과 카드에서, 원하는 만큼의 기간으로 끌어다 놓으세요. Kosha가 계좌를 만들고, 거래를 가져와 거래처별로 정리해요. 저장하기 전에 결과를 확인할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep alle afschriften die je hebt hierheen, van elke bank en kaart, zoveel maanden als je wilt. Kosha maakt de rekeningen aan, importeert de transacties en sorteert ze op tegenpartij, en jij controleert het resultaat voordat er iets wordt opgeslagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte todos os extratos que tiver, de cada banco e cartão, de quantos meses quiser. O Kosha cria as contas, importa as transações e as organiza por favorecido, e você confere o resultado antes de qualquer coisa ser salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите все выписки, что у вас есть, по каждому банку и карте, за сколько угодно месяцев. Kosha создаст счета, импортирует операции и разберёт их по контрагентам, а вы проверите результат, прежде чем что-либо сохранится."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "把你所有银行和信用卡的对账单都拖进来，几个月都行。Kosha 会设置好账户、导入交易并按交易对象整理，保存之前由你检查结果。"
          }
        }
      }
    },
