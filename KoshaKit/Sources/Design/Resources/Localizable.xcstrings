        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 계정이 맞는지 확인하기 위해 이메일 주소를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ je e-mailadres om te bevestigen dat dit het account is dat je bedoelt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu endereço de e-mail para confirmar que esta é a conta certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес почты, чтобы подтвердить, что это нужный аккаунт."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你的邮箱地址，确认这就是你要删除的账号。"
          }
        }
