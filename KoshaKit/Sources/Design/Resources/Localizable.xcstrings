    "settings_sec_google_description_no_password": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Leg ein Passwort fest, bevor du Google trennst, damit du dich weiter anmelden kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected. Set a password before you disconnect it, so you can still sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. Crea una contraseña antes de desconectarlo, para poder seguir iniciando sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associé. Définissez un mot de passe avant de le dissocier, pour pouvoir toujours vous connecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्टेड। इसे डिस्कनेक्ट करने से पहले एक पासवर्ड सेट करें, ताकि आप साइन इन कर सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegato. Imposta una password prima di scollegarlo, così potrai ancora accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携済み。連携を解除してもログインできるよう、先にパスワードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨. 연결을 끊은 뒤에도 로그인할 수 있도록 먼저 비밀번호를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppeld. Stel een wachtwoord in voordat je het ontkoppelt, zodat je nog kunt inloggen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. Crie uma senha antes de desconectá-lo, para que você ainda consiga entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено. Перед отключением задайте пароль, чтобы по-прежнему можно было войти."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已关联。断开之前请先设置密码，以便你仍能登录。"
          }
        }
      }
    },
