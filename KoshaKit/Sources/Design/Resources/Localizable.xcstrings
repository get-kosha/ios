    "settings_general_add_kind_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Womit Hinzufügen auf dem Handy und in der Schnelleingabe startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Add starts with on your phone and in quick add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué empieza Añadir en tu móvil y en la entrada rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce par quoi Ajouter commence sur votre téléphone et dans la saisie rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ोन पर और झटपट जोड़ें में जोड़ें किससे शुरू होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cosa si apre Aggiungi sul telefono e nell'aggiunta rapida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホの追加画面とクイック入力で、最初に選ばれる種類です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰의 추가 화면과 빠른 추가에서 처음 선택되는 유형."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarmee Toevoegen begint op je telefoon en bij snel toevoegen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Adicionar começa no celular e na adição rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чего начинается добавление на телефоне и в быстром вводе."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上和快速添加中，“添加”默认的类型。"
          }
        }
