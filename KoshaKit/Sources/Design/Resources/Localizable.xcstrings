            "value": "पहले एक पासवर्ड सेट करें। टू-फ़ैक्टर पासवर्ड वाले साइन-इन को सुरक्षित करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta prima una password. L'autenticazione a due fattori protegge l'accesso con password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にパスワードを設定してください。2段階認証はパスワードでのログインを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 비밀번호를 설정하세요. 2단계 인증은 비밀번호 로그인을 보호해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel eerst een wachtwoord in. Tweestapsverificatie beschermt inloggen met een wachtwoord."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma senha primeiro. Os dois fatores protegem o login com senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала задайте пароль. Двухфакторная аутентификация защищает вход по паролю."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请先设置密码。双重验证用于保护密码登录。"
          }
        }
      }
    },
    "settings_sec_two_factor_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Passwort zusätzlich nach einem Code aus einer Authenticator-App fragen (1Password, Authy…)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your password, ask for a code from an authenticator app (1Password, Authy…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de tu contraseña, pide un código de una app de autenticación (1Password, Authy…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre mot de passe, demander un code d'une application d'authentification (1Password, Authy…)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड के बाद, ऑथेंटिकेटर ऐप (1Password, Authy…) से एक कोड माँगें।"
          }
        },
        "it": {
          "stringUnit": {
