        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो एंट्रियाँ जोड़ेंगे, वे यहाँ दिखेंगी। बस कुछ सेकंड: रकम, किसे दिया, हो गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I movimenti che aggiungi compaiono qui. Bastano pochi secondi: importo, beneficiario, fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加した取引がここに表示されます。金額と支払先を入れるだけで数秒で終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 거래가 여기에 표시돼요. 금액과 거래처만 입력하면 몇 초면 끝나요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties die je toevoegt, verschijnen hier. Het kost een paar seconden: bedrag, begunstigde, klaar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lançamentos que você adicionar aparecem aqui. Leva poucos segundos: valor, favorecido, pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавленные операции появятся здесь. Это пара секунд: сумма, получатель, готово."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加的交易会显示在这里。只需几秒：金额、收款方，完成。"
          }
        }
      }
