    "settings_api_docs_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Operation mit ihren Feldern und Beispielen, aus derselben Liste, die auch die MCP-Werkzeuge nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every operation with its fields and examples, from the same list the MCP tools use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada operación con sus campos y ejemplos, a partir de la misma lista que usan las herramientas MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque opération avec ses champs et exemples, à partir de la même liste que les outils MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ऑपरेशन, उसके फ़ील्ड और उदाहरणों के साथ, उसी सूची से जिसे MCP टूल इस्तेमाल करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni operazione con i suoi campi ed esempi, dallo stesso elenco usato dagli strumenti MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての操作とその項目、例を、MCPツールと同じ一覧から掲載しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 도구와 같은 목록을 바탕으로, 모든 작업의 필드와 예시를 담고 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bewerking met haar velden en voorbeelden, uit dezelfde lijst die de MCP-tools gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as operações com seus campos e exemplos, da mesma lista que as ferramentas MCP usam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все операции API с полями и примерами — из того же списка, что и инструменты MCP."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "所有操作及其字段和示例，与 MCP 工具使用同一份列表。"
          }
        }
      }
    },
