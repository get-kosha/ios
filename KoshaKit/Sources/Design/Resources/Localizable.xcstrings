    "app_act_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hinzufügst, erscheint hier. Das dauert nur Sekunden: Betrag, Empfänger, fertig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries you add show up here. It takes a few seconds: amount, payee, done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que añadas aparecerá aquí. Lleva unos segundos: importe, beneficiario, listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations que vous ajoutez apparaissent ici. Quelques secondes suffisent : montant, bénéficiaire, terminé."
