    "settings_ai_categorise_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt eine Kategorie für Zahlungspartner, die weder eine Regel noch eine frühere Buchung zuordnen kann. Sie bleibt mit ✦ markiert, bis du entscheidest, und ein Tippen ändert sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks a category for a payee no rule or past entry can place. It's marked ✦ until you choose, and one tap changes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una categoría para un beneficiario que ninguna regla ni movimiento anterior puede ubicar. Se marca con ✦ hasta que decidas, y con un toque se cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit une catégorie pour un tiers qu'aucune règle ni opération passée ne permet de classer. Elle est marquée ✦ jusqu'à ce que vous choisissiez, et une touche suffit pour la changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी पार्टी के लिए श्रेणी चुनता है जिसे कोई नियम या पिछली एंट्री तय नहीं कर पाती। जब तक आप खुद न चुनें, उस पर ✦ लगा रहता है, और एक टैप से उसे बदला जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie una categoria per un beneficiario che nessuna regola o movimento passato sa collocare. Resta segnata con ✦ finché non scegli tu, e basta un tocco per cambiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールや過去の取引から判断できない取引先にカテゴリを設定します。確定するまで ✦ が付き、ワンタップで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙이나 지난 거래로 분류할 수 없는 거래처의 카테고리를 골라요. 직접 확정하기 전까지 ✦ 표시가 붙고, 한 번 탭하면 바꿀 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiest een categorie voor een tegenpartij die geen regel of eerdere transactie kan plaatsen. Hij is gemarkeerd met ✦ totdat jij kiest, en met één tik verander je hem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma categoria para um favorecido que nenhuma regra ou lançamento anterior consegue classificar. Fica marcada com ✦ até você decidir, e um toque a altera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбирает категорию для контрагента, которого не удалось отнести ни правилом, ни по прошлым операциям. Пока вы не выберете сами, она отмечена ✦, и изменить её можно одним касанием."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有规则或过往交易能确定分类时，为交易对象选择一个分类。在你确认之前会标记 ✦，点一下即可更改。"
          }
        }
      }
    },
    "settings_ai_categorise_sends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Zahlungspartner und wie deine häufigsten Zahlungspartner einsortiert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payee, and how your most-used payees are sorted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El beneficiario y cómo están clasificados tus beneficiarios más usados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tiers, et la façon dont vos tiers les plus fréquents sont classés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पार्टी, और आपकी सबसे ज़्यादा इस्तेमाल होने वाली पार्टियाँ किन श्रेणियों में हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il beneficiario, e come sono classificati i tuoi beneficiari più usati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引先と、よく使う取引先のカテゴリ分けの内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래처, 그리고 가장 자주 쓰는 거래처들의 분류 방식."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tegenpartij, en hoe je meestgebruikte tegenpartijen zijn ingedeeld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O favorecido e como seus favorecidos mais usados estão classificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрагент и то, как распределены ваши самые частые контрагенты."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "交易对象，以及你最常用的交易对象是如何分类的。"
          }
        }
      }
    },
